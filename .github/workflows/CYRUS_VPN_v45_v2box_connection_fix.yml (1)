          // ============================================================
          //  اسکن QR
          // ============================================================
          
          // ---- خواندن QR بدون ML Kit (ZXing خالص دارت) ----
          
          /// ورودی: [خاکستری، عرض، طول]؛ خروجی: متن QR یا null
          /// هر دو روش آستانه‌گذاری (Hybrid برای نور ناهمگون و QR فشرده، Global برای تصویر تمیز)
          /// و هم حالت معمولی و هم رنگ‌معکوس امتحان می‌شه
          String? _zxDecode(List<Object> a) {
            final gray = a[0] as Uint8List;
            final w = a[1] as int;
            final h = a[2] as int;
            final tryInv = a.length > 3 ? a[3] as bool : true;
            for (final inv in tryInv ? const [false, true] : const [false]) {
              final px = Int32List(w * h);
              for (int i = 0; i < px.length; i++) {
                final g = inv ? 255 - gray[i] : gray[i];
                px[i] = 0xFF000000 | (g << 16) | (g << 8) | g;
              }
              final src = RGBLuminanceSource(w, h, px);
              for (final hybrid in const [true, false]) {
                try {
                  final bmp = BinaryBitmap(hybrid ? HybridBinarizer(src) : GlobalHistogramBinarizer(src));
                  final res = QRCodeReader().decode(bmp);
                  final text = res.text;
                  if (text.isNotEmpty) return text;
                } catch (_) {}
              }
            }
            return null;
          }
          
          /// تصویر → [خاکستری، عرض، طول]؛ بدون width اندازه اصلی (بزرگ‌تر از ۲۰۰۰ پیکسل رد می‌شه)
          Future<List<Object>?> _grayFromImage(Uint8List bytes, int? width) async {
            try {
              final codec = width == null
                  ? await ui.instantiateImageCodec(bytes)
                  : await ui.instantiateImageCodec(bytes, targetWidth: width);
              final frame = await codec.getNextFrame();
              final im = frame.image;
              if (width == null && im.width > 2000) {
                im.dispose();
                return null;
              }
              final data = await im.toByteData(format: ui.ImageByteFormat.rawRgba);
              final w = im.width, h = im.height;
              im.dispose();
              if (data == null) return null;
              final rgba = data.buffer.asUint8List();
              final gray = Uint8List(w * h);
              for (int i = 0; i < gray.length; i++) {
                final o = i * 4;
                gray[i] = (rgba[o] * 299 + rgba[o + 1] * 587 + rgba[o + 2] * 114) ~/ 1000;
              }
              return <Object>[gray, w, h];
            } catch (_) {
              return null;
            }
          }
          
          /// بزرگ‌کردن پیکسلی (بدون محو شدن لبه‌ها)؛ برای QR کوچک و فشرده
          Uint8List _nnUpscale(Uint8List g, int w, int h, int k) {
            final nw = w * k, nh = h * k;
            final out = Uint8List(nw * nh);
            for (int y = 0; y < nh; y++) {
              final sy = (y ~/ k) * w;
              final dy = y * nw;
              for (int x = 0; x < nw; x++) {
                out[dy + x] = g[sy + (x ~/ k)];
              }
            }
            return out;
          }
          
          Future<String?> _decodeQrFromImage(Uint8List bytes) async {
            // اول اندازه اصلی، بعد بزرگ‌کردن پیکسلی، بعد اندازه‌های دیگه
            final base = await _grayFromImage(bytes, null);
            if (base != null) {
              var r = await compute(_zxDecode, base);
              if (r != null) return r;
              final w = base[1] as int, h = base[2] as int;
              if (w > 0 && w < 900) {
                final k = (900 ~/ w) + 1;
                final up = _nnUpscale(base[0] as Uint8List, w, h, k);
                r = await compute(_zxDecode, <Object>[up, w * k, h * k]);
                if (r != null) return r;
              }
            }
            for (final width in const [1000, 640, 1600]) {
              final g = await _grayFromImage(bytes, width);
              if (g == null) continue;
              final r = await compute(_zxDecode, g);
              if (r != null) return r;
            }
            return null;
          }
          
          class QrScanPage extends StatefulWidget {
            const QrScanPage({super.key});
          
            @override
            State<QrScanPage> createState() => _QrScanPageState();
          }
          
          class _QrScanPageState extends State<QrScanPage> with WidgetsBindingObserver {
            CameraController? _cc;
            PermissionStatus? _perm;
            String _camError = '';
            bool _done = false;
            bool _torch = false;
            bool _asking = false;
            bool _busy = false;
            bool _starting = false;
            DateTime _lastTry = DateTime.fromMillisecondsSinceEpoch(0);
          
            @override
            void initState() {
              super.initState();
              WidgetsBinding.instance.addObserver(this);
              _ask();
            }
          
            @override
            void dispose() {
              WidgetsBinding.instance.removeObserver(this);
              _stopCamera();
              super.dispose();
            }
          
            @override
            void didChangeAppLifecycleState(AppLifecycleState state) {
              if (state == AppLifecycleState.resumed && _perm != PermissionStatus.granted) {
                _check();
              }
            }
          
            Future<void> _check() async {
              try {
                final s = await Permission.camera.status;
                if (s.isGranted && mounted) {
                  setState(() => _perm = s);
                  _startCamera();
                }
              } catch (_) {}
            }
          
            Future<void> _ask() async {
              if (_asking) return;
              _asking = true;
              try {
                var s = await Permission.camera.status;
                if (!s.isGranted) s = await Permission.camera.request();
                if (!mounted) return;
                setState(() => _perm = s);
                if (s.isGranted) _startCamera();
              } catch (_) {
                if (mounted) setState(() => _perm = PermissionStatus.denied);
              } finally {
                _asking = false;
              }
            }
          
            Future<void> _stopCamera() async {
              final c = _cc;
              _cc = null;
              if (c == null) return;
              try {
                if (c.value.isStreamingImages) await c.stopImageStream();
              } catch (_) {}
              try {
                await c.dispose();
              } catch (_) {}
            }
          
            Future<void> _startCamera() async {
              if (_starting || _cc != null) return;
              _starting = true;
              try {
                final cams = await availableCameras();
                if (cams.isEmpty) throw 'no camera';
                final cam = cams.firstWhere(
                    (c) => c.lensDirection == CameraLensDirection.back,
                    orElse: () => cams.first);
                final c = CameraController(cam, ResolutionPreset.veryHigh,
                    enableAudio: false, imageFormatGroup: ImageFormatGroup.yuv420);
                await c.initialize();
                if (!mounted) {
                  await c.dispose();
                  return;
                }
                _cc = c;
                _camError = '';
                // فوکوس و نور خودکار؛ QR فشرده بدون فوکوس خوب خونده نمی‌شه
                try {
                  await c.setFocusMode(FocusMode.auto);
                } catch (_) {}
                try {
                  await c.setExposureMode(ExposureMode.auto);
                } catch (_) {}
                await c.startImageStream(_onFrame);
                if (mounted) setState(() {});
              } catch (e) {
                _camError = e.toString();
                await _stopCamera();
                if (mounted) setState(() {});
              } finally {
                _starting = false;
              }
            }
          
            int _frameN = 0;
          
            void _onFrame(CameraImage img) {
              if (_busy || _done) return;
              final now = DateTime.now();
              if (now.difference(_lastTry).inMilliseconds < 350) return;
              _lastTry = now;
              _busy = true;
              try {
                _frameN++;
                final w = img.width, h = img.height;
                final plane = img.planes[0];
                final stride = plane.bytesPerRow;
                final src = plane.bytes;
                // بیشتر فریم‌ها فقط مربع وسط (سریع‌تر)، هر سومی کل تصویر
                int x0 = 0, y0 = 0, cw = w, ch = h;
                if (_frameN % 3 != 0) {
                  final side = (math.min(w, h) * 0.92).floor();
                  cw = side;
                  ch = side;
                  x0 = (w - side) ~/ 2;
                  y0 = (h - side) ~/ 2;
                }
                final gray = Uint8List(cw * ch);
                for (int y = 0; y < ch; y++) {
                  final so = (y0 + y) * stride + x0, d = y * cw;
                  gray.setRange(d, d + cw, src, so);
                }
                // حالت رنگ‌معکوس (کندتر) فقط گاهی امتحان می‌شه
                compute(_zxDecode, <Object>[gray, cw, ch, _frameN % 4 == 0]).then((r) {
                  _busy = false;
                  if (r != null) _finish(r);
                }).catchError((_) {
                  _busy = false;
                });
              } catch (_) {
                _busy = false;
              }
            }
          
            void _finish(String v) {
              if (_done || !mounted) return;
              _done = true;
              Navigator.of(context).pop(v);
            }
          
            void _msg(String m) {
              if (!mounted) return;
              ScaffoldMessenger.of(context)
                ..hideCurrentSnackBar()
                ..showSnackBar(SnackBar(content: Text(m)));
            }
          
            /// عکس QR از گالری، یا عکس گرفتن با برنامه‌ی دوربین خود گوشی
            Future<void> _pickImage({bool camera = false}) async {
              try {
                final x = await ImagePicker().pickImage(
                    source: camera ? ImageSource.camera : ImageSource.gallery);
                if (x == null) return;
                _msg(tr('در حال خواندن QR...', 'Reading the QR...'));
                final bytes = await x.readAsBytes();
                final text = await _decodeQrFromImage(bytes);
                if (text != null) {
                  _finish(text);
                } else {
                  _msg(tr('تو این عکس QR پیدا نشد', 'No QR code found in this image'));
                }
              } catch (e) {
                _msg(tr('خواندن عکس ناموفق بود: $e', 'Could not read the image: $e'));
              }
            }
          
