            // Combined score uses only measured throughput and measured tunnel latency.
            double _score(Cfg c) {
              final p = _pings[c.link];
              final s = _speeds[c.link];
              if (p == null || p <= 0 || s == null || s <= 0) return -1;
              return s / (1 + p / 150.0);
            }
          
            // If both profiles have measured speeds, rank by throughput + latency.
            // Unknown speed remains unknown and is never converted into a fabricated zero.
            int _cmpBest(Cfg a, Cfg b) {
              final sa = _score(a), sb = _score(b);
              if (sa >= 0 && sb >= 0) {
                final scoreOrder = sb.compareTo(sa);
                if (scoreOrder != 0) return scoreOrder;
              } else if (sa >= 0 && sb < 0) {
                return -1;
              } else if (sb >= 0 && sa < 0) {
                return 1;
              }
              return _pings[a.link]!.compareTo(_pings[b.link]!);
            }
          
