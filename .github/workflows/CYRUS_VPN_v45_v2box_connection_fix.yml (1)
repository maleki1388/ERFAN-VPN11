      - name: Patch Android settings
        working-directory: app/android
        run: |
          M=app/src/main/AndroidManifest.xml
          sed -i 's/android:label="[^"]*"/android:label="CYRUS VPN"/' $M
          python3 - <<'PY'
          import re
          p = 'app/src/main/AndroidManifest.xml'
          s = open(p, encoding='utf-8').read()
          for perm in ['INTERNET', 'CAMERA', 'POST_NOTIFICATIONS', 'FOREGROUND_SERVICE', 'ACCESS_NETWORK_STATE', 'REQUEST_IGNORE_BATTERY_OPTIMIZATIONS', 'WAKE_LOCK']:
              if 'android.permission.' + perm not in s:
                  s = re.sub(r'(<manifest[^>]*>)', r'\1\n    <uses-permission android:name="android.permission.' + perm + '"/>', s, count=1)
          if 'hasFragileUserData' not in s:
              s = s.replace('<application', '<application android:hasFragileUserData="true"', 1)
          open(p, 'w', encoding='utf-8').write(s)
          PY
          # اعلان: سرعت آپلود/دانلود روی اعلان سرویس (کد بومی کوچک)
          K=app/src/main/kotlin/com/erfan/erfan
          find app/src/main -name 'MainActivity.*' -delete
          mkdir -p "$K"
          cat > "$K/MainActivity.kt" <<'KT'
          package com.erfan.erfan

          import android.app.Notification
          import android.app.NotificationManager
          import android.app.PendingIntent
          import android.content.Context
          import android.content.Intent
          import android.graphics.drawable.Icon
          import android.os.Build
          import android.os.Bundle
          import android.os.Handler
          import android.os.Looper
          import android.os.PowerManager
          import android.service.notification.StatusBarNotification
          import io.flutter.embedding.android.FlutterActivity
          import io.flutter.embedding.engine.FlutterEngine
          import io.flutter.plugin.common.MethodChannel

          class MainActivity : FlutterActivity() {
              private var channel: MethodChannel? = null

              companion object {
                  var pendingDisconnect = false
                  var wl: PowerManager.WakeLock? = null
                  const val ACTION_DISCONNECT = "com.erfan.erfan.CYRUS_DISCONNECT"
              }

              override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
                  super.configureFlutterEngine(flutterEngine)
                  val ch = MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "cyrus/notif")
                  channel = ch
                  ch.setMethodCallHandler { call, result ->
                      when (call.method) {
                          "update" -> {
                              val text = call.argument<String>("text") ?: ""
                              val big = call.argument<String>("big") ?: text
                              val label = call.argument<String>("label") ?: "Disconnect"
                              result.success(updateNotification(text, big, label))
                          }
                          "pending" -> {
                              val p = pendingDisconnect
                              pendingDisconnect = false
                              result.success(p)
                          }
                          "moveToBack" -> {
                              moveTaskToBack(true)
                              result.success(true)
                          }
                          "wakelock" -> {
                              val on = call.argument<Boolean>("on") ?: false
                              result.success(setWakeLock(on))
                          }
                          else -> result.notImplemented()
                      }
                  }
              }

              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)
                  handleIntent(intent)
              }

              override fun onNewIntent(intent: Intent) {
                  super.onNewIntent(intent)
                  handleIntent(intent)
              }

              private fun handleIntent(i: Intent?) {
                  if (i == null || i.action != ACTION_DISCONNECT) return
                  i.action = null
                  pendingDisconnect = true
                  setWakeLock(false)
                  val ch = channel
                  if (ch != null) {
                      ch.invokeMethod("disconnect", null, object : MethodChannel.Result {
                          override fun success(result: Any?) {
                              pendingDisconnect = false
                              moveTaskToBack(true)
                          }
                          override fun error(errorCode: String, errorMessage: String?, errorDetails: Any?) {}
                          override fun notImplemented() {}
                      })
                  }
                  // اگه دارت هنوز آماده نبود، بعد از چند ثانیه برنامه عقب می‌ره (دارت خودش قطع رو بعداً انجام می‌ده)
                  Handler(Looper.getMainLooper()).postDelayed({ if (pendingDisconnect) moveTaskToBack(true) }, 5000)
              }

              private fun setWakeLock(on: Boolean): Boolean {
                  return try {
                      if (on) {
                          if (wl == null) {
                              val pm = applicationContext.getSystemService(Context.POWER_SERVICE) as PowerManager
                              val l = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "cyrus:vpn")
                              l.setReferenceCounted(false)
                              wl = l
                          }
                          wl?.acquire(8 * 60 * 60 * 1000L)
                      } else {
                          val l = wl
                          if (l != null && l.isHeld) l.release()
                      }
                      true
                  } catch (e: Exception) {
                      false
                  }
              }

              private fun updateNotification(text: String, big: String, label: String): Boolean {
                  if (Build.VERSION.SDK_INT < Build.VERSION_CODES.N) return false
                  try {
                      val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
                      var found: StatusBarNotification? = null
                      for (sbn in nm.activeNotifications) {
                          if ((sbn.notification.flags and Notification.FLAG_FOREGROUND_SERVICE) != 0) {
                              found = sbn
                              break
                          }
                      }
                      val f = found ?: return false
                      val b = Notification.Builder.recoverBuilder(applicationContext, f.notification)
                      b.setContentText(text)
                      b.setStyle(Notification.BigTextStyle().bigText(big))
                      b.setOnlyAlertOnce(true)
                      // دکمه قطع اتصال خودمون: دکمه خود افزونه فقط برنامه رو باز می‌کرد
                      val i = Intent(applicationContext, MainActivity::class.java)
                      i.action = ACTION_DISCONNECT
                      i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_CLEAR_TOP)
                      val pi = PendingIntent.getActivity(
                          applicationContext, 7351, i,
                          PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
                      )
                      val icon = Icon.createWithResource(applicationContext, android.R.drawable.ic_menu_close_clear_cancel)
                      val act = Notification.Action.Builder(icon, label, pi).build()
                      b.setActions(act)
                      nm.notify(f.id, b.build())
                      return true
                  } catch (e: Exception) {
                      return false
                  }
              }

              override fun onDestroy() {
                  if (isFinishing) {
                      updateNotification("Connected", "Connected", "Disconnect")
                  }
                  super.onDestroy()
              }
          }
          KT
          for G in app/build.gradle.kts app/build.gradle; do
            if [ -f "$G" ]; then
              sed -i 's/minSdk = flutter.minSdkVersion/minSdk = 24/; s/minSdkVersion flutter.minSdkVersion/minSdkVersion 24/; s/compileSdk = flutter.compileSdkVersion/compileSdk = 36/; s/compileSdkVersion flutter.compileSdkVersion/compileSdkVersion 36/' "$G"
              if [ "$G" = "app/build.gradle.kts" ]; then
                sed -i '0,/^android {/s//android {\n    packaging { jniLibs { useLegacyPackaging = true } }/' "$G"
              else
                sed -i '0,/^android {/s//android {\n    packagingOptions { jniLibs { useLegacyPackaging = true } }/' "$G"
              fi
            fi
          done
          printf '\nandroid.suppressUnsupportedCompileSdk=36\n' >> gradle.properties
          cat $M

      - name: Force compileSdk 36 for all plugins
        run: |
          mkdir -p ~/.gradle/init.d
          cat > ~/.gradle/init.d/force-compilesdk.gradle <<'GRADLE_EOF'
          import groovy.xml.XmlSlurper

          allprojects {
              // lint در بیلد release یکی از پلاگین‌ها (camera_android_camerax) کرش می‌کنه؛ برای APK لازم نیست
              tasks.configureEach { t ->
                  if (t.name.startsWith('lintVital') || t.name.startsWith('lintAnalyze') || t.name.startsWith('lintReport')) {
                      t.enabled = false
                  }
              }
              afterEvaluate { p ->
                  def ext = p.extensions.findByName('android')
                  if (ext != null) {
                      try { ext.compileSdkVersion 36 } catch (Throwable t) { println "compileSdk skip: ${p.name}" }
                      try {
                          if (ext.hasProperty('namespace') && ext.namespace == null) {
                              def mf = p.file('src/main/AndroidManifest.xml')
                              if (mf.exists()) {
                                  def pk = new XmlSlurper().parse(mf).@package.toString()
                                  if (pk) { ext.namespace = pk }
                              }
                          }
                      } catch (Throwable t) { println "namespace skip: ${p.name}" }
                  }
              }
          }
          GRADLE_EOF
          cat ~/.gradle/init.d/force-compilesdk.gradle

