            /// نویسه‌های نامرئی و فاصله‌های اضافه رو پاک می‌کنه
            String _cleanInput(String s) =>
                s.replaceAll(RegExp('[\u200B-\u200F\u2028-\u202F\uFEFF]'), '').trim();
          
            /// متن base64 (معمولی یا url-safe) رو اگه داخلش کانفیگ بود باز می‌کنه
            String? _tryBase64(String t) {
              final c = t.replaceAll(RegExp(r'\s+'), '');
              if (c.length < 16 || !RegExp(r'^[A-Za-z0-9+/_\-]+=*$').hasMatch(c)) return null;
              try {
                final n = base64.normalize(c.replaceAll('-', '+').replaceAll('_', '/'));
                final d = utf8.decode(base64.decode(n)).trim();
                if (d.contains('://') || d.startsWith('{') || _looksLikeWgConf(d)) return d;
              } catch (_) {}
              return null;
            }
          
            /// هر نوع ورودی (QR، کلیپ‌بورد، فایل): لینک، چند لینک، JSON، آرایه JSON،
            /// فایل WireGuard، لینک ساب، base64 و لینک‌های اشتراک‌گذاری برنامه‌ها
            Future<void> _handleInput(String input, {int depth = 0}) async {
              var text = _cleanInput(input);
              if (text.isEmpty) return _toast(tr('چیزی پیدا نشد', 'Nothing found'));
          
              // متنی که URL-encode شده
              if (!text.contains('://') && text.contains('%3A%2F%2F')) {
                try {
                  text = Uri.decodeFull(text).trim();
                } catch (_) {}
              }
          
              // لینک اشتراک‌گذاری برنامه‌ها: v2rayng://install-config?url=https://...
              if (!text.startsWith('{') && !text.startsWith('[')) {
                final u = Uri.tryParse(text.split(RegExp(r'\s')).first);
                if (u != null && u.hasScheme && !_coreSchemes.any((x) => text.toLowerCase().startsWith(x))) {
                  final low = u.scheme.toLowerCase();
                  final q = u.queryParameters['url'];
                  if (low != 'http' && low != 'https' && q != null && q.toLowerCase().startsWith('http')) {
                    return _handleInput(q, depth: depth + 1);
                  }
                }
              }
          
              if (text.startsWith('{')) {
                try {
                  final j = jsonDecode(text);
                  if (j is Map && j['outbounds'] is List) {
                    await _addManual([text]);
                  } else {
                    _toast(tr('این JSON کانفیگ Xray نیست (outbounds نداره)',
                        'This JSON is not an Xray config (no outbounds)'));
                  }
                } catch (_) {
                  _toast(tr('JSON معتبر نیست', 'Invalid JSON'));
                }
                return;
              }
          
              if (_looksLikeWgConf(text)) {
                final m = _wgFromConf(text);
                if (m == null) {
                  _toast(tr('کانفیگ WireGuard ناقصه (کلید، آدرس یا Endpoint نیست)',
                      'Incomplete WireGuard config (key, address or endpoint missing)'));
                } else {
                  await _addManual([jsonEncode(m)]);
                }
                return;
              }
          
              // آرایه‌ای از کانفیگ‌های JSON
              if (text.startsWith('[')) {
                try {
                  final j = jsonDecode(text);
                  if (j is List) {
                    final items = <String>[];
                    for (final e in j) {
                      if (e is Map && e['outbounds'] is List) items.add(jsonEncode(e));
                      if (e is String && _isLink(e)) items.add(e.trim());
                    }
                    if (items.isNotEmpty) {
                      await _addManual(items);
                      return;
                    }
                  }
                } catch (_) {}
              }
          
              final links = text.split(RegExp(r'[\r\n\s]+')).where(_isLink).toList();
              if (links.isNotEmpty) {
                await _addManual(links);
                return;
              }
          
              if (text.startsWith('http://') || text.startsWith('https://')) {
                if (!_subs.contains(text)) _subs.add(text);
                await _save();
                await _updateOneSub(text);
                return;
              }
          
              // متن base64 که داخلش کانفیگ یا لیست کانفیگ‌هاست
              if (depth < 2) {
                final d = _tryBase64(text);
                if (d != null && d != text) return _handleInput(d, depth: depth + 1);
              }
              _toast(tr('کانفیگ یا ساب معتبر نیست', 'Not a valid config or subscription'));
            }
          
            Future<void> _addManual(List<String> links) async {
              int added = 0;
              final fresh = <Cfg>[];
              for (final l in links) {
                if (!_configs.any((c) => c.link == l)) {
                  final nc = Cfg(l, null);
                  _configs.add(nc);
                  fresh.add(nc);
                  added++;
                }
              }
              _selected ??= _configs.isNotEmpty ? _configs.first.link : null;
              _resort();
              setState(() {});
              // Wait for preferences + backup to finish before returning to the input flow.
              // This prevents newly-added configs disappearing if the app is closed quickly.
              await _save();
              _toast(tr('$added کانفیگ اضافه شد', '$added config(s) added'));
              if (fresh.isNotEmpty) _pingConfigs(fresh, manual: true, tries: 2);
            }
          
