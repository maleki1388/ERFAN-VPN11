              final l = _activeLink ?? _selected;
              if (l == null) return;
              _measuring = true;
              if (mounted) setState(() {});
              final v = await _downloadMbps();
              final u = _connected ? await _uploadMbps() : null;
              _measuring = false;
              if (!_connected) {
                if (mounted) setState(() {});
                return;
              }
              final now = DateTime.now().millisecondsSinceEpoch;
              if (v != null) {
                _speeds[l] = v;
                _speedAt[l] = now;
              }
              if (u != null) _ups[l] = u;
              if (v != null || u != null) {
                _resort();
                await _save();
