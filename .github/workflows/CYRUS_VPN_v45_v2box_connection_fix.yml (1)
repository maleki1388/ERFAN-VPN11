name: CYRUS VPN build v45
on:
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: cyrus-build-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    env:
      KEYSTORE_B64: ${{ secrets.ANDROID_KEYSTORE_B64 }}
    steps:
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Cache Gradle
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: gradle-${{ runner.os }}-${{ hashFiles('.github/workflows/build.yml') }}
          restore-keys: |
            gradle-${{ runner.os }}-

      - name: Install NDK required by the VPN plugin
        continue-on-error: true
        run: |
          SDK="${ANDROID_SDK_ROOT:-$ANDROID_HOME}"
          yes | "$SDK/cmdline-tools/latest/bin/sdkmanager" --licenses >/dev/null 2>&1 || true
          "$SDK/cmdline-tools/latest/bin/sdkmanager" --install "ndk;27.0.12077973" || true

      - name: Create project
        run: flutter create --org com.erfan --project-name erfan --platforms=android app

      - name: Write app code
        run: |
          rm -rf app/test
          cat > app/lib/main.dart <<'DART_EOF'
          import 'dart:async';
          import 'dart:convert';
          import 'dart:math' as math;
          
          
          import 'package:flutter/material.dart';
          import 'package:flutter/services.dart';
          import 'package:flutter_v2ray_client/flutter_v2ray.dart';
          import 'package:flutter_v2ray_client/model/v2ray_status.dart';
          
          import 'package:http/http.dart' as http;
          import 'dart:io';
          
          import 'package:image_picker/image_picker.dart';
          import 'package:file_picker/file_picker.dart';
          import 'package:path_provider/path_provider.dart';
          import 'package:permission_handler/permission_handler.dart';
          import 'package:camera/camera.dart';
          import 'package:zxing2/qrcode.dart';
          import 'dart:typed_data';
          import 'dart:ui' as ui;
          import 'package:flutter/foundation.dart' show compute, debugPrint;
          import 'package:shared_preferences/shared_preferences.dart';
          
          // ============================================================
          //  ثابت‌ها و زبان
          // ============================================================
          
          const appName = 'CYRUS VPN';
          const cGreen = Color(0xFF00E676);
          
          Color _hsl(double h, double s, double l) => HSLColor.fromAHSL(
                  1, h % 360, s.clamp(0.0, 1.0).toDouble(), l.clamp(0.0, 1.0).toDouble())
              .toColor();
          
          class AppTheme {
            final String fa, en;
            final Color bg0, bg1, accent, accent2, line, surface, nav, navLine;
            final Color btnFill, btnIn, btnInLine, idle, card, selected, panel;
            AppTheme(this.fa, this.en,
                {required this.bg0,
                required this.bg1,
                required this.accent,
                required this.accent2,
                required this.line,
                required this.surface,
                required this.nav,
                required this.navLine,
                required this.btnFill,
                required this.btnIn,
                required this.btnInLine,
                required this.idle,
                required this.card,
                required this.selected,
                required this.panel});
          }
          
          AppTheme _mk(String fa, String en,
              {required double acc,
              double accSat = 1.0,
              double accL = 0.56,
              required double tint,
              double tintSat = 0.65,
              Color? top,
              Color? bottom}) {
            return AppTheme(fa, en,
                bg0: bottom ?? _hsl(tint, tintSat, 0.03),
                bg1: top ?? _hsl(tint, tintSat, 0.11),
                accent: _hsl(acc, accSat, accL),
                accent2: _hsl(acc + 8, accSat, accL + 0.05),
                line: _hsl(acc, accSat * 0.7, accL * 0.8),
                surface: _hsl(tint, tintSat, 0.085),
                nav: _hsl(tint, tintSat, 0.045),
                navLine: _hsl(tint, tintSat * 0.9, 0.14),
                btnFill: _hsl(tint, tintSat, 0.055),
                btnIn: _hsl(tint, tintSat * 0.85, 0.09),
                btnInLine: _hsl(tint, tintSat * 0.8, 0.17),
                idle: _hsl(acc, accSat * 0.6, 0.48),
                card: _hsl(tint, tintSat, 0.10),
                selected: _hsl(tint, tintSat * 0.8, 0.24),
                panel: _hsl(tint, tintSat, 0.065));
          }
          
          final List<AppTheme> kThemes = [
            _mk('آبی نئونی', 'Neon Cyan', acc: 190, tint: 228, tintSat: 0.68, top: const Color(0xFF071A2D), bottom: const Color(0xFF02050D)),
            _mk('بنفش', 'Purple', acc: 270, tint: 268),
            _mk('قرمز', 'Red', acc: 355, tint: 355),
            _mk('سبز', 'Green', acc: 145, tint: 150),
            _mk('زرد', 'Yellow', acc: 48, accL: 0.55, tint: 45, tintSat: 0.6),
            _mk('نارنجی', 'Orange', acc: 24, tint: 22),
            _mk('صورتی', 'Pink', acc: 325, tint: 325),
            _mk('مشکی', 'Black',
                acc: 0, accSat: 0, accL: 0.85, tint: 0, tintSat: 0,
                top: const Color(0xFF111111), bottom: const Color(0xFF000000)),
            _mk('قرمز و مشکی', 'Red × Black',
                acc: 355, tint: 355, tintSat: 0.55,
                top: const Color(0xFF45000A), bottom: const Color(0xFF000000)),
            _mk('طلایی و مشکی', 'Gold × Black',
                acc: 45, accL: 0.55, tint: 42, tintSat: 0.5,
                top: const Color(0xFF3A2A00), bottom: const Color(0xFF000000)),
            _mk('بنفش و آبی', 'Purple × Blue',
                acc: 262, tint: 250, tintSat: 0.6,
                top: const Color(0xFF2E1065), bottom: const Color(0xFF020A2E)),
            _mk('صورتی و بنفش', 'Pink × Purple',
                acc: 315, tint: 300, tintSat: 0.55,
                top: const Color(0xFF5A0E4A), bottom: const Color(0xFF14062A)),
            _mk('سبز و مشکی', 'Green × Black',
                acc: 140, tint: 150, tintSat: 0.55,
                top: const Color(0xFF00421C), bottom: const Color(0xFF000000)),
            _mk('آتش', 'Fire',
                acc: 18, tint: 10, tintSat: 0.6,
                top: const Color(0xFF5A1A00), bottom: const Color(0xFF1C0004)),
            _mk('اقیانوس', 'Ocean',
                acc: 185, tint: 200, tintSat: 0.6,
                top: const Color(0xFF004050), bottom: const Color(0xFF020F22)),
          ];
          
          final ValueNotifier<int> themePref = ValueNotifier<int>(0);
          
          AppTheme get curTheme {
            final i = themePref.value;
            return kThemes[(i < 0 || i >= kThemes.length) ? 0 : i];
          }
          
          Color get cBg0 => curTheme.bg0;
          Color get cBg1 => curTheme.bg1;
          Color get cBlue => curTheme.accent;
          Color get cCyan => curTheme.accent2;
          Color get cLine => curTheme.line;
          Color get cAccent => curTheme.accent;
          Color get cCard => curTheme.card;
          Color get cSelected => curTheme.selected;
          Color get cPanel => curTheme.panel;
          Color get cCardA => curTheme.card.withOpacity(0.93);
          Color get cSurface => curTheme.surface;
          Color get cNav => curTheme.nav;
          Color get cNavLine => curTheme.navLine;
          Color get cBtnFill => curTheme.btnFill;
          Color get cBtnIn => curTheme.btnIn;
          Color get cBtnInLine => curTheme.btnInLine;
          Color get cIdle => curTheme.idle;
          
          
          final ValueNotifier<String> langPref = ValueNotifier<String>('fa');
          
          bool get isFa {
            return langPref.value != 'en';
          }
          
          String tr(String fa, String en) => isFa ? fa : en;
          
          // ============================================================
          //  تنظیمات برنامه (ذخیره‌شده)
          // ============================================================
          
          class AppSettings {
            String lang = 'fa';
            bool autoBest = true;
            bool autoSwitch = false;
            bool autoUpdate = true;
            bool autoSpeed = false;
            bool autoReconnect = true;
            bool batteryAsked = false;
            bool wantOn = false;
            bool perf = false;
            bool realPing = false; // پینگ واقعی با هسته (کندتر)؛ خاموش = پینگ TCP تا سرور
            bool debugLog = false; // لاگ دقیق هسته (کندتر)
            bool nightMode = true; // وقتی وصلیم CPU نخوابه (پایداری شبانه)
            int theme = 0;
            bool fragment = false;
            int ver = 0;
            bool permOk = false;
            String ua = 'v2rayNG/1.8.5';
            bool proxyOnly = false;
            bool bypassLan = false;
            String dnsPreset = 'default';
            String dnsCustom = '';
            String domainStrategy = 'default';
            bool bypassIr = false;
            String directDomains = '';
            String blockDomains = '';
            String deviceId = '';
          
            Map<String, dynamic> toMap() => {
                  'lang': lang,
                  'autoSpeed': autoSpeed,
           'autoReconnect': autoReconnect,
           'batteryAsked': batteryAsked,
           'wantOn': wantOn,
           'perf': perf,
           'realPing': realPing,
           'debugLog': debugLog,
           'nightMode': nightMode,
           'theme': theme,
           'fragment': fragment,
                  'ver': ver,
           'permOk': permOk,
                  'autoBest': autoBest,
                  'autoSwitch': autoSwitch,
                  'autoUpdate': autoUpdate,
                  'ua': ua,
                  'proxyOnly': proxyOnly,
                  'bypassLan': bypassLan,
                  'dnsPreset': dnsPreset,
                  'dnsCustom': dnsCustom,
                  'domainStrategy': domainStrategy,
                  'bypassIr': bypassIr,
                  'directDomains': directDomains,
                  'blockDomains': blockDomains,
                  'deviceId': deviceId,
                };
          
            Future<void> load() async {
              final p = await SharedPreferences.getInstance();
              final raw = p.getString('settings');
              if (raw != null) {
                try {
                  final m = jsonDecode(raw) as Map<String, dynamic>;
                  lang = (m['lang'] ?? lang) as String;
                  autoSpeed = (m['autoSpeed'] ?? autoSpeed) as bool;
           autoReconnect = (m['autoReconnect'] ?? autoReconnect) as bool;
           batteryAsked = (m['batteryAsked'] ?? batteryAsked) as bool;
           wantOn = (m['wantOn'] ?? wantOn) as bool;
           perf = (m['perf'] ?? perf) as bool;
           realPing = (m['realPing'] ?? realPing) as bool;
           debugLog = (m['debugLog'] ?? debugLog) as bool;
           nightMode = (m['nightMode'] ?? nightMode) as bool;
           theme = (m['theme'] ?? theme) as int;
           fragment = (m['fragment'] ?? fragment) as bool;
                  ver = (m['ver'] ?? 0) as int;
           permOk = (m['permOk'] ?? permOk) as bool;
                  autoBest = (m['autoBest'] ?? autoBest) as bool;
                  autoSwitch = (m['autoSwitch'] ?? autoSwitch) as bool;
                  autoUpdate = (m['autoUpdate'] ?? autoUpdate) as bool;
                  ua = (m['ua'] ?? ua) as String;
                  proxyOnly = (m['proxyOnly'] ?? proxyOnly) as bool;
                  bypassLan = (m['bypassLan'] ?? bypassLan) as bool;
                  dnsPreset = (m['dnsPreset'] ?? dnsPreset) as String;
                  dnsCustom = (m['dnsCustom'] ?? dnsCustom) as String;
                  domainStrategy = (m['domainStrategy'] ?? domainStrategy) as String;
                  bypassIr = (m['bypassIr'] ?? bypassIr) as bool;
                  directDomains = (m['directDomains'] ?? directDomains) as String;
                  blockDomains = (m['blockDomains'] ?? blockDomains) as String;
                  deviceId = (m['deviceId'] ?? deviceId) as String;
                } catch (_) {}
              }
              if (ver < 2) {
                // نسخه جدید: وصل شدن خودکار و فرگمنت پیش‌فرض خاموش
                fragment = false;
                autoSpeed = false;
                autoReconnect = false;
                wantOn = false;
                ver = 2;
                await save();
              }
              if (ver < 3) {
                // تعویض خودکار کانفیگ وسط اتصال باعث قطع و وصل می‌شد؛ پیش‌فرض خاموش
                autoSwitch = false;
                ver = 3;
                await save();
              }
              if (ver < 4) {
                // کانفیگ دست‌نخورده (مثل V2Box) پیش‌فرض؛ دستکاری‌های اضافه خاموش
                perf = false;
                ver = 4;
                await save();
              }
              if (ver < 5) {
                // قطع شدن شبانه: وصل مجدد خودکار پیش‌فرض روشن
                autoReconnect = true;
                ver = 5;
                await save();
              }
              if (lang != 'en') lang = 'fa';
              if (deviceId.isEmpty) {
                deviceId = _uuid();
                await save();
              }
              themePref.value = (theme < 0 || theme >= kThemes.length) ? 0 : theme;
              langPref.value = lang;
            }
          
            Future<void> save() async {
              final p = await SharedPreferences.getInstance();
              await p.setString('settings', jsonEncode(toMap()));
            }
          
            List<String> listOf(String s) => s
                .split(RegExp(r'[,\s]+'))
                .map((e) => e.trim().toLowerCase())
                .where((e) => e.isNotEmpty)
                .toList();
          
            List<String> dnsServers() {
              switch (dnsPreset) {
                case 'google':
                  return ['8.8.8.8', '8.8.4.4'];
                case 'cloudflare':
                  return ['1.1.1.1', '1.0.0.1'];
                case 'quad9':
                  return ['9.9.9.9', '149.112.112.112'];
                case 'adguard':
                  return ['94.140.14.14', '94.140.15.15'];
                case 'custom':
                  return dnsCustom
                      .split(RegExp(r'[,\s]+'))
                      .map((e) => e.trim())
                      .where((e) => e.isNotEmpty)
                      .toList();
                default:
                  return [];
              }
            }
          }
          
          final AppSettings S = AppSettings();
          
          String _uuid() {
            final r = math.Random.secure();
            final b = List<int>.generate(16, (_) => r.nextInt(256));
            b[6] = (b[6] & 0x0f) | 0x40;
            b[8] = (b[8] & 0x3f) | 0x80;
            String h(int i) => b[i].toRadixString(16).padLeft(2, '0');
            return '${h(0)}${h(1)}${h(2)}${h(3)}-${h(4)}${h(5)}-${h(6)}${h(7)}-${h(8)}${h(9)}-${h(10)}${h(11)}${h(12)}${h(13)}${h(14)}${h(15)}';
          }
          
          // ============================================================
          //  main
          // ============================================================
          
          Future<void> main() async {
            await runZonedGuarded(() async {
              WidgetsFlutterBinding.ensureInitialized();
              initEventLog();
              FlutterError.onError = (d) => _coreEvent('FLUTTER ${d.exceptionAsString()}');
              ErrorWidget.builder = (details) => Material(
                    color: Colors.black,
                    child: Center(
                      child: Padding(
                        padding: const EdgeInsets.all(20),
                        child: Text(details.exceptionAsString(),
                            style: const TextStyle(color: Colors.redAccent, fontSize: 12)),
                      ),
                    ),
                  );
              try {
                await S.load();
              } catch (_) {}
              runApp(const ErfanApp());
            }, (error, stack) {
              _coreEvent('UNCAUGHT $error');
            });
          }
          
          class ErfanApp extends StatelessWidget {
            const ErfanApp({super.key});
          
            @override
            Widget build(BuildContext context) {
              return ValueListenableBuilder<int>(
                valueListenable: themePref,
                builder: (_, __, ___) => MaterialApp(
                title: appName,
                debugShowCheckedModeBanner: false,
                theme: ThemeData(
                  useMaterial3: true,
                  brightness: Brightness.dark,
                  colorScheme: ColorScheme.fromSeed(
                      seedColor: cAccent, brightness: Brightness.dark),
                  scaffoldBackgroundColor: Colors.transparent,
                ),
                builder: (context, child) => ValueListenableBuilder<String>(
                  valueListenable: langPref,
                  builder: (_, __, ___) => Directionality(
                    textDirection: isFa ? TextDirection.rtl : TextDirection.ltr,
                    child: child!,
                  ),
                ),
                home: const HomePage(),
              ));
            }
          }
          
          // ============================================================
          //  مدل‌ها
          // ============================================================
          
          const String buildTag = 'v45';
          V2ray? coreHandle;
          final List<String> coreEvents = [];
          String lastSentCfg = '';
          
          String _hhmmss() {
            final n = DateTime.now();
            String two(int v) => v.toString().padLeft(2, '0');
            return '${two(n.hour)}:${two(n.minute)}:${two(n.second)}';
          }
          
          String prevSessionEvents = '';
          String eventsPath() => '${Directory.systemTemp.path}/erfan_events.log';
          
          /// رویدادهای نشست قبلی (اگه برنامه ناگهانی بسته شده باشه آخرینشون دلیل رو نشون می‌ده)
          void initEventLog() {
            try {
              final f = File(eventsPath());
              if (f.existsSync()) {
                final ls = f.readAsStringSync().split('\n');
                prevSessionEvents = (ls.length > 60 ? ls.sublist(ls.length - 60) : ls).join('\n').trim();
              }
              f.writeAsStringSync('--- session ${DateTime.now()}\n');
            } catch (_) {}
          }
          
          void _coreEvent(String e) {
            final line = '${_hhmmss()} $e';
            coreEvents.add(line);
            if (coreEvents.length > 60) coreEvents.removeAt(0);
            try {
              File(eventsPath()).writeAsStringSync('$line\n', mode: FileMode.append, flush: true);
            } catch (_) {}
          }
          
          /// کلیدها و رمزها پنهان می‌شن تا بشه گزارش رو امن فرستاد
          dynamic _maskSecrets(dynamic v) {
            const secret = {'secretkey', 'publickey', 'presharedkey', 'privatekey', 'password', 'id', 'uuid'};
            if (v is Map) {
              return {
                for (final e in v.entries)
                  e.key: secret.contains(e.key.toString().toLowerCase()) ? '***' : _maskSecrets(e.value),
              };
            }
            if (v is List) return v.map(_maskSecrets).toList();
            return v;
          }
          
          const MethodChannel _notifCh = MethodChannel('cyrus/notif');
          
          String fmtRateB(double b) {
            if (b < 1024) return '${b.toStringAsFixed(1)} B/s';
            if (b < 1048576) return '${(b / 1024).toStringAsFixed(1)} KB/s';
            return '${(b / 1048576).toStringAsFixed(2)} MB/s';
          }
          
          String fmtTotalB(int b) {
            if (b < 1024) return '$b B';
            if (b < 1048576) return '${(b / 1024).toStringAsFixed(1)} KB';
            if (b < 1073741824) return '${(b / 1048576).toStringAsFixed(1)} MB';
            return '${(b / 1073741824).toStringAsFixed(2)} GB';
          }
          
          String coreLogPath() => '${Directory.systemTemp.path}/erfan_core.log';
          
          /// آخرین بخش لاگ هسته رو نشون می‌ده و اجازه کپی می‌ده
          Future<void> _showCoreLogDialog(BuildContext context) async {
            String text;
            try {
              final f = File(coreLogPath());
              if (await f.exists()) {
                final len = await f.length();
                final bytes = <int>[];
                await for (final part in f.openRead(len > 65536 ? len - 65536 : 0)) {
                  bytes.addAll(part);
                }
                final ls = utf8.decode(bytes, allowMalformed: true).split('\n');
                text = (ls.length > 120 ? ls.sublist(ls.length - 120) : ls).join('\n').trim();
                if (text.isEmpty) text = tr('(لاگ هسته خالیه)', '(core log is empty)');
              } else {
                text = tr('(فایل لاگ هنوز ساخته نشده)', '(no log file yet)');
              }
            } catch (e) {
              text = tr('(خواندن لاگ ممکن نشد)', '(could not read the log)');
            }
            String ver = '';
            String plog = '';
            try {
              ver = await coreHandle?.getCoreVersion().timeout(const Duration(seconds: 3)) ?? '';
            } catch (_) {}
            try {
              final ls = await coreHandle?.getLogs().timeout(const Duration(seconds: 4)) ?? <String>[];
              plog = (ls.length > 80 ? ls.sublist(ls.length - 80) : ls).join('\n');
            } catch (_) {}
            text = '== app ==\nCYRUS $buildTag\n\n'
                '${prevSessionEvents.isEmpty ? '' : '== previous session (before last close) ==\n$prevSessionEvents\n\n'}'
                '== events ==\n${coreEvents.isEmpty ? '(none)' : coreEvents.join('\n')}\n\n'
                '== config sent (secrets hidden) ==\n${lastSentCfg.isEmpty ? '(none)' : lastSentCfg}\n\n'
                '== core version ==\n${ver.isEmpty ? '(unknown)' : ver}\n\n'
                '== plugin logs (logcat) ==\n${plog.isEmpty ? '(empty)' : plog}\n\n'
                '== core log file ==\n$text';
            if (!context.mounted) return;
            await showDialog<void>(
              context: context,
              builder: (ctx) => AlertDialog(
                title: Text(tr('گزارش هسته', 'Core log')),
                content: SizedBox(
                  width: double.maxFinite,
                  child: SingleChildScrollView(
                    child: SelectableText(text, style: const TextStyle(fontSize: 11, fontFamily: 'monospace')),
                  ),
                ),
                actions: [
                  TextButton(
                    onPressed: () {
                      Clipboard.setData(ClipboardData(text: text));
                      Navigator.of(ctx).pop();
                    },
                    child: Text(tr('کپی', 'Copy')),
                  ),
                  TextButton(onPressed: () => Navigator.of(ctx).pop(), child: Text(tr('بستن', 'Close'))),
                ],
              ),
            );
          }
          
          class _Ep {
            final String host;
            final int port;
            const _Ep(this.host, this.port);
          }
          
          class Cfg {
            final String link; // لینک کانفیگ یا متن JSON کامل
            final String? sub; // آدرس ساب (اگه از ساب اومده)
            Cfg(this.link, this.sub);
          
            bool get isJson => link.startsWith('{');
          
            Map<String, dynamic> toJson() => {'l': link, 's': sub};
            factory Cfg.fromJson(Map<String, dynamic> j) =>
                Cfg(j['l'] as String, j['s'] as String?);
          }
          
          class SubInfo {
            String name;
            int used;
            int total;
            int expire; // epoch seconds
            SubInfo({this.name = '', this.used = 0, this.total = 0, this.expire = 0});
          
            Map<String, dynamic> toJson() =>
                {'n': name, 'u': used, 't': total, 'e': expire};
            factory SubInfo.fromJson(Map<String, dynamic> j) => SubInfo(
                  name: (j['n'] ?? '') as String,
                  used: (j['u'] ?? 0) as int,
                  total: (j['t'] ?? 0) as int,
                  expire: (j['e'] ?? 0) as int,
                );
          }
          
          class CfgGroup {
            final String? sub;
            final String title;
            final List<Cfg> items;
            CfgGroup(this.sub, this.title, this.items);
          }
          
          class SubRow {
            final String title;
            final int count;
            final int used;
            final int total;
            final int expire;
            SubRow(this.title, this.count, this.used, this.total, this.expire);
          }
          
          String _gb(int b) => '${(b / 1073741824).toStringAsFixed(1)} GB';
          
          /// تاریخ انقضا رو به ثانیه برمی‌گردونه؛ ۰ یعنی «نامشخص / بدون انقضا».
          /// میلی‌ثانیه (>= 1e11) به ثانیه تبدیل می‌شه و مقدار خارج از بازه ۲۰۰۱ تا ۲۱۰۰ نامعتبره.
          int _normExpire(int v) {
            if (v <= 0) return 0;
            if (v >= 100000000000) v = v ~/ 1000;
            if (v < 978307200 || v > 4102444800) return 0;
            return v;
          }
          
          int? _daysLeft(int expire) {
            final e = _normExpire(expire);
            if (e <= 0) return null;
            final ms = e * 1000 - DateTime.now().millisecondsSinceEpoch;
            return (ms / 86400000).ceil();
          }
          
