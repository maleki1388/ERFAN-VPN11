            void _onStatus(V2RayStatus s) {
              final was = _status.state;
              if (s.state != was) _coreEvent('status: $was → ${s.state}');
              if (s.state == 'CONNECTED') {
                _dropSeen = false;
                _rcAttempt = 0;
              } else if (was == 'CONNECTED' &&
                  s.state == 'DISCONNECTED' && S.wantOn) {
                // فقط قطع غیرمنتظره را reconnect کن؛ قطع دستی قبل از stop مقدار wantOn را false می‌کند.
                _dropSeen = true;
                _rcNext = DateTime.now().add(const Duration(seconds: 2));
                _coreEvent('unexpected disconnect; reconnect queued');
              }
              if (s.state == 'CONNECTED') {
                final dt = _tick.elapsedMilliseconds / 1000.0;
                if (was != 'CONNECTED' || !_tick.isRunning) {
                  _lastDl = s.download;
                  _lastUl = s.upload;
                  _tick
                    ..reset()
                    ..start();
                  _dlMbps = 0;
                  _ulMbps = 0;
                } else if (dt >= 0.3) {
                  final dd = math.max(0, s.download - _lastDl);
                  final du = math.max(0, s.upload - _lastUl);
                  _dlMbps = dd * 8 / 1e6 / dt;
                  _ulMbps = du * 8 / 1e6 / dt;
                  _lastDl = s.download;
                  _lastUl = s.upload;
                  _tick
                    ..reset()
                    ..start();
                  _push(_dlHist, _dlMbps);
                  _push(_ulHist, _ulMbps);
                  if (_dlMbps > _peakDl) _peakDl = _dlMbps;
                }
              } else {
                _dlMbps = 0;
                _ulMbps = 0;
                _tick.stop();
                if (was == 'CONNECTED') {
                  _dlHist.clear();
                  _ulHist.clear();
                  _pingHist.clear();
                  _livePing = 0;
                }
              }
              if (was != 'CONNECTED' && s.state == 'CONNECTED') _onConnected();
              if (s.state == 'CONNECTED') {
                if (S.nightMode && !_wakeOn) {
                  _wakeOn = true;
                  _wakeAt = DateTime.now();
                  _wake(true);
                }
                _notifUpdate(s);
              } else if (s.state == 'DISCONNECTED' && _wakeOn) {
                _wakeOn = false;
                _wake(false);
              }
              if (mounted) setState(() => _status = s);
            }
          
            bool _watchBusy = false;
            bool _cancelConnect = false;
            int _rot = 0;
            final Set<String> _verified = {};
          
            /// بعد از وصل شدن چک می‌کنه اینترنت واقعاً از تونل رد می‌شه؛ اگه نه، روش بعدی رو خودکار امتحان می‌کنه
            Future<void> _verifyTunnel() async {
              if (_watchBusy) return;
              _watchBusy = true;
              try {
                final link = _activeLink;
                final c = link == null ? null : _byLink(link);
                final cur = c == null ? 0 : (_strat[c.link] ?? ((_isWg(c) || !S.fragment) ? 0 : 2));
          
                // روش اتصال بعدی که ارزش امتحان داره (کانفیگ متفاوت می‌سازه)؛ اگه هست زودتر تصمیم می‌گیریم
                int? nextStrat;
                if (c != null && _rot < 3 && _isWg(c)) {
                  const seq = [0, 2, 1, 3];
                  nextStrat = seq[(seq.indexOf(cur) + 1) % seq.length];
                } else if (c != null && _rot < 3) {
                  String curCfg = '';
                  try {
                    curCfg = _buildConfig(c, strat: cur);
                  } catch (_) {}
                  final seen = <String>{curCfg};
                  for (final x in const [0, 1, 2, 3]) {
                    if (x == cur) continue;
                    String cfg = '';
                    try {
                      cfg = _buildConfig(c, strat: x);
                    } catch (_) {}
                    if (cfg.isEmpty || !seen.add(cfg)) continue;
                    nextStrat = x;
                    break;
                  }
                }
                final attempts = nextStrat == null ? 3 : 2;
                final secs = nextStrat == null ? 8 : 6;
          
                await Future.delayed(const Duration(milliseconds: 2500));
                bool ok = false;
                for (int i = 0; i < attempts && !ok; i++) {
                  if (!_connected || _activeLink != link) return;
                  try {
                    final r = await http
                        .get(Uri.parse(i == 1 ? _pingUrlA : _pingUrlB))
                        .timeout(Duration(seconds: secs));
                    ok = r.statusCode == 204 || r.statusCode == 200;
                  } catch (_) {}
                }
                if (!_connected || _activeLink != link) return;
                if (ok) {
                  _coreEvent('verify ok strat=$cur');
                  _rot = 0;
                  if (link != null) {
                    _verified.add(link);
                    _deadAt.remove(link);
                  }
                  // روشی که جواب داد ذخیره می‌شه تا دفعه بعد مستقیم همون استفاده بشه
                  if (c != null && _strat[c.link] != cur) {
                    _strat[c.link] = cur;
                    _save();
                  }
                  return;
                }
                _coreEvent('verify FAILED strat=$cur next=$nextStrat');
                if (c == null) return;
                // قبلاً اینجا خودکار قطع و وصل می‌شد (چرخش روش‌ها) و باعث گیر کردن دکمه می‌شد؛
                // مثل v2rayNG فقط خبر می‌دیم و تصمیم با کاربره
                // هیچ روشی جواب نداد: روش امتحان‌شده‌ی آخر ذخیره نمی‌مونه و دفعه بعد از پیش‌فرض شروع می‌شه
                if (_strat.remove(c.link) != null) _save();
                _rot = 0;
                if (_isWg(c)) {
                  _toast(tr('WireGuard اجرا شد ولی با سرور دست‌دادن (handshake) انجام نشد؛ کلیدها، Endpoint و باز بودن پورت UDP رو چک کن',
                      'WireGuard started but the handshake did not complete; check the keys, endpoint and that the UDP port is open'));
                } else {
                  _toast(tr('این کانفیگ وصل شد ولی اینترنت از آن رد نمی‌شه؛ کانفیگ دیگه‌ای امتحان کن',
                      'Connected, but no traffic passes through this config. Try another one'));
                }
              } finally {
                _watchBusy = false;
              }
            }
          
            void _onConnected() {
