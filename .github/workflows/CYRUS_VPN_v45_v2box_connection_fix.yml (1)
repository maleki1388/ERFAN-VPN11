            String _key(String link) => link.startsWith('{') ? link : link.split('#').first;
          
              /// اتصال قطع شده؛ برو روی بهترین کانفیگ دیگه
            Future<void> _failover() async {
              if (!S.autoSwitch || _probing || !_connected) return;
              final now = DateTime.now();
              if (now.difference(_lastFailover).inSeconds < 60) return;
              _lastFailover = now;
              final cur = _activeLink ?? _selected;
              Cfg? best;
              for (final c in _configs) {
                final p = _pings[c.link];
                if (c.link == cur || p == null || p <= 0) continue;
                if (best == null || _cmpBest(c, best) < 0) best = c;
              }
              if (best == null) {
                await _pingAll(manual: true);
                for (final c in _configs) {
                  final p = _pings[c.link];
                  if (c.link == cur || p == null || p <= 0) continue;
                  if (best == null || _cmpBest(c, best) < 0) best = c;
                }
              }
              if (best == null || !_connected) return;
              _toast(tr('اینترنت این کانفیگ قطع شد، رفتم روی بهترین',
                  'This config stopped working, switching to the best one'));
              _selected = best.link;
              await _save();
              await _switchTo();
            }
          
            /// پینگ واقعی کانفیگ وصل از داخل خود هسته؛ -1 جواب نیومد، -2 افزونه پشتیبانی نمی‌کنه
            Future<int> _connectedDelay() async {
              if (_noConnDelay) return -2;
              for (final u in const [_pingUrlB, _pingUrlA]) {
                try {
                  final dynamic v = _v2ray;
                  dynamic x;
                  try {
                    x = await v.getConnectedServerDelay(url: u).timeout(const Duration(seconds: 6));
                  } on NoSuchMethodError {
                    // نسخه افزونه آدرس تست رو قبول نمی‌کنه
                    x = await v.getConnectedServerDelay().timeout(const Duration(seconds: 6));
                    return (x is num) ? x.toInt() : -1;
                  }
                  final int r = (x is num) ? x.toInt() : -1;
                  if (r > 0) return r;
                } on NoSuchMethodError {
                  _noConnDelay = true;
                  return -2;
                } catch (_) {}
              }
              return -1;
            }
          
            /// روش جایگزین وقتی افزونه پینگ کانفیگ وصل رو نداره؛ ۰ یعنی سالمه ولی حساب نمی‌شه
            Future<int> _httpLive() async {
              final c = _live;
              if (c == null) return -1;
              final sw = Stopwatch()..start();
              try {
                final r = await c
                    .get(Uri.parse(_pingUrlB))
                    .timeout(const Duration(seconds: 4));
                sw.stop();
                if (r.statusCode == 204 || r.statusCode == 200) {
                  _liveN++;
                  // اولین درخواست DNS و دست‌دادن TLS داره، پس حساب نمی‌شه
                  return _liveN > 1 ? math.max(sw.elapsedMilliseconds, 1) : 0;
                }
                return -1;
              } catch (_) {
                _liveN = 0;
                _live?.close();
                _live = http.Client();
                return -1;
              }
            }
          
            int _bgTick = 0;
            DateTime _notifLast = DateTime.fromMillisecondsSinceEpoch(0);
          
