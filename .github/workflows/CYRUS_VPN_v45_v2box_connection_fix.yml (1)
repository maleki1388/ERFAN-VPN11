            Future<bool> _tunnelAlive() async {
              if (S.proxyOnly) return true;
              for (final u in const [_pingUrlB, _pingUrlA]) {
                try {
                  final r = await http.get(Uri.parse(u)).timeout(const Duration(seconds: 6));
                  if (r.statusCode == 204 || r.statusCode == 200) return true;
                } catch (_) {}
              }
