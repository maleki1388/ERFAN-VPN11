          class CyberWorldMapPainter extends CustomPainter {
            final Color blue;
            final Color purple;
            CyberWorldMapPainter(this.blue, this.purple);
          
            @override
            void paint(Canvas canvas, Size size) {
              final p = Paint()..style = PaintingStyle.fill;
              // Dot clusters form a deliberately abstract, low-contrast world map.
              final regions = <List<Offset>>[
                [const Offset(.08,.25),const Offset(.16,.16),const Offset(.27,.18),const Offset(.34,.28),const Offset(.28,.39),const Offset(.20,.42),const Offset(.13,.35),const Offset(.06,.33)],
                [const Offset(.30,.48),const Offset(.36,.54),const Offset(.39,.67),const Offset(.34,.82),const Offset(.29,.69)],
                [const Offset(.48,.24),const Offset(.55,.18),const Offset(.62,.22),const Offset(.67,.32),const Offset(.62,.42),const Offset(.55,.39),const Offset(.50,.32)],
                [const Offset(.66,.24),const Offset(.76,.16),const Offset(.88,.20),const Offset(.96,.29),const Offset(.91,.41),const Offset(.82,.44),const Offset(.73,.36)],
                [const Offset(.79,.52),const Offset(.87,.56),const Offset(.90,.68),const Offset(.84,.76),const Offset(.78,.66)],
              ];
              for (int r = 0; r < regions.length; r++) {
                final pts = regions[r];
                final color = r >= 3 ? purple : blue;
                p.color = color.withOpacity(.75);
                for (int y = 0; y < 15; y++) {
                  for (int x = 0; x < 24; x++) {
                    final u = (x + .5) / 24;
                    final v = (y + .5) / 15;
                    bool inside = false;
                    for (int i = 0, j = pts.length - 1; i < pts.length; j = i++) {
                      final a = pts[i], b = pts[j];
                      if (((a.dy > v) != (b.dy > v)) &&
                          (u < (b.dx - a.dx) * (v - a.dy) / ((b.dy - a.dy) == 0 ? .0001 : (b.dy - a.dy)) + a.dx)) inside = !inside;
                    }
                    if (inside) {
                      final radius = ((x + y + r) % 4 == 0) ? 1.5 : 1.0;
                      canvas.drawCircle(Offset(u * size.width, v * size.height), radius, p);
                    }
                  }
                }
              }
            }
          
            @override
            bool shouldRepaint(covariant CyberWorldMapPainter old) => old.blue != blue || old.purple != purple;
          }
          
