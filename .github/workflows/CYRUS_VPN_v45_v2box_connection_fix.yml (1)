            void _parseSubHeaders(String url, Map<String, String> h) {
              final info = _subInfo[url] ?? SubInfo();
              final title = h['profile-title'];
              if (title != null && title.isNotEmpty) {
                var t = title;
                if (t.startsWith('base64:')) {
                  try {
                    t = utf8.decode(base64.decode(base64.normalize(t.substring(7))));
                  } catch (_) {}
                }
                info.name = t;
              }
              final ui0 = h['subscription-userinfo'];
              if (ui0 != null && ui0.trim().isNotEmpty) {
                int? up, down, total, exp;
                for (final part in ui0.split(';')) {
                  final i = part.indexOf('=');
                  if (i <= 0) continue;
                  final k = part.substring(0, i).trim().toLowerCase();
                  final raw = part.substring(i + 1).trim();
                  int? v = int.tryParse(raw);
                  if (v == null) {
                    final d = double.tryParse(raw);
                    if (d != null && d.isFinite) v = d.toInt();
                  }
                  if (v == null || v < 0) continue; // مقدار خراب نادیده گرفته می‌شه، صفر فرض نمی‌شه
                  switch (k) {
                    case 'upload':
                      up = v;
                    case 'download':
                      down = v;
                    case 'total':
                      total = v;
                    case 'expire':
                      exp = v;
                  }
                }
                if (up != null || down != null) info.used = (up ?? 0) + (down ?? 0);
                if (total != null) info.total = total;
                if (exp != null) info.expire = _normExpire(exp);
              }
              _subInfo[url] = info;
            }
          
            Future<bool> _updateSub(String url, {bool announce = false}) async {
              try {
                final res = await http
                    .get(Uri.parse(url), headers: {
                      'User-Agent': S.ua,
                      'Accept': '*/*',
                      'Cache-Control': 'no-cache',
                      // شناسه دستگاه برای پنل‌هایی که دستگاه‌ها رو می‌شمارن و نشون می‌دن
                      'x-hwid': S.deviceId,
                      'x-device-os': 'Android',
                      'x-device-model': 'Cyrus',
                      'x-ver-os': 'Android',
                    })
                    .timeout(const Duration(seconds: 30));
                if (res.statusCode != 200) {
                  if (announce) {
                    _toast(tr('سرور ساب جواب درست نداد (${res.statusCode})',
                        'Subscription server error (${res.statusCode})'));
                  }
                  return false;
                }
          
                // پاسخ ساب ممکنه لینک خام، Base64 معمولی/URL-safe یا Base64
                // دارای فاصله و خط جدید باشه. اول UTF-8 خام رو بررسی می‌کنیم.
                String body = utf8.decode(res.bodyBytes, allowMalformed: true).trim();
                if (body.startsWith('\uFEFF')) body = body.substring(1).trim();
          
                List<String> extractLinks(String source) => source
                    .replaceAll('\uFEFF', '')
                    .split(RegExp(r'[\r\n]+'))
                    .map((e) => e.trim())
                    .where(_isLink)
                    .toList();
          
                var links = extractLinks(body);
                if (links.isEmpty) {
                  // بعضی ارائه‌دهنده‌ها Base64 رو با فاصله/خط جدید یا URL-safe می‌فرستن.
                  final compact = body.replaceAll(RegExp(r'\s+'), '');
                  try {
                    final normalized = base64.normalize(
                        compact.replaceAll('-', '+').replaceAll('_', '/'));
                    final decoded = utf8
                        .decode(base64.decode(normalized), allowMalformed: true)
                        .trim();
                    links = extractLinks(decoded);
                    if (links.isEmpty) {
                      // پشتیبانی از پاسخ‌هایی که یک لایه Base64 اضافی دارند.
                      final compact2 = decoded.replaceAll(RegExp(r'\s+'), '');
                      final normalized2 = base64.normalize(
                          compact2.replaceAll('-', '+').replaceAll('_', '/'));
                      final decoded2 = utf8
                          .decode(base64.decode(normalized2), allowMalformed: true)
                          .trim();
                      links = extractLinks(decoded2);
                    }
                  } catch (_) {
                    // پاسخ غیر Base64 است؛ خطای خواندن پایین‌تر به کاربر نمایش داده می‌شود.
                  }
                }
          
                _parseSubHeaders(url, res.headers);
                if (links.isEmpty) {
                  if (announce) {
                    _toast(tr('پاسخ ساب دریافت شد، اما لینک پشتیبانی‌شده‌ای داخلش نبود',
                        'Subscription downloaded, but no supported config links were found'));
                  }
                  return false;
                }
          
                // حذف تکراری‌ها بدون تغییر ترتیب کانفیگ‌های دریافتی.
                links = links.toSet().toList();
                final oldCfgs = _configs.where((c) => c.sub == url).toList();
                _configs.removeWhere((c) => c.sub == url);
                for (final l in links) {
                  if (!_configs.any((c) => c.link == l)) _configs.add(Cfg(l, url));
                }
          
                // اگه فقط اسم/توضیح کانفیگ تغییر کرده، انتخاب و نتایج تست رو منتقل کن.
                for (final o in oldCfgs) {
                  if (_byLink(o.link) != null) continue;
                  Cfg? n;
                  for (final c in _configs) {
                    if (c.sub == url && _key(c.link) == _key(o.link)) {
                      n = c;
                      break;
                    }
                  }
                  if (n == null) continue;
                  if (_selected == o.link) _selected = n.link;
                  if (_activeLink == o.link) _activeLink = n.link;
                  final sp = _speeds[o.link];
                  if (sp != null) {
                    _speeds[n.link] = sp;
                    _speedAt[n.link] = _speedAt[o.link] ?? 0;
                  }
                  final up = _ups[o.link];
                  if (up != null) _ups[n.link] = up;
                  final cu = _custom[o.link];
                  if (cu != null) _custom[n.link] = cu;
                }
                if (_byLink(_selected) == null && !_connected) {
                  _selected = _configs.isNotEmpty ? _configs.first.link : null;
                  _picked = false;
                }
                _lastSubUpdate = DateTime.now();
                await _save();
                if (announce) {
                  _toast(tr('ساب آپدیت شد (${links.length} کانفیگ)',
                      'Subscription updated (${links.length} configs)'));
                }
                return true;
              } catch (e) {
                debugPrint('subscription update failed: ${e.runtimeType}');
                if (announce) {
                  _toast(tr('دریافت ساب ناموفق بود؛ اتصال اینترنت یا لینک را بررسی کن',
                      'Could not fetch subscription; check connection or URL'));
