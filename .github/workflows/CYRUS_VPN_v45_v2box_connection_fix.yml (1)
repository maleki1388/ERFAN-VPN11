            /// کانفیگ کامل xray با خروجی wireguard (ورودی‌ها مثل بقیه کانفیگ‌ها socks:10808 و http:10809)
            Map<String, dynamic> _wgConfig({
              required String secretKey,
              required List<String> address,
              required List<Map<String, dynamic>> peers,
              int? mtu,
              List<int>? reserved,
              List<String>? dns,
              String remark = 'WireGuard',
            }) {
              Map<String, dynamic> sniff() => {
                    'enabled': true,
                    'destOverride': ['http', 'tls'],
                    'routeOnly': false,
                  };
              return {
                'remarks': remark,
                'log': {'loglevel': 'warning'},
                'inbounds': [
                  {
                    'tag': 'socks',
                    'port': 10808,
                    'listen': '127.0.0.1',
                    'protocol': 'socks',
                    'sniffing': sniff(),
                    'settings': {'auth': 'noauth', 'udp': true, 'allowTransparent': false},
                  },
                  {
                    'tag': 'http',
                    'port': 10809,
                    'listen': '127.0.0.1',
                    'protocol': 'http',
                    'sniffing': sniff(),
                    'settings': {'auth': 'noauth', 'udp': false, 'allowTransparent': false},
                  },
                ],
                'outbounds': [
                  {
                    'tag': 'proxy',
                    'protocol': 'wireguard',
                    'settings': {
                      'secretKey': secretKey,
                      'address': address,
                      'peers': [
                        for (final p in peers)
                          {
                            // Preserve values from the imported WireGuard profile.
                            'allowedIPs': p['allowedIPs'] ?? const ['0.0.0.0/0', '::/0'],
                            ...p,
                          }
                      ],
                      'mtu': mtu ?? 1280,
                      if (reserved != null && reserved.length == 3) 'reserved': reserved,
                    },
                  },
                  {'tag': 'direct', 'protocol': 'freedom', 'settings': {}},
                  {'tag': 'block', 'protocol': 'blackhole', 'settings': {}},
                ],
                'dns': {
                  'servers': [
                    ...?dns,
                    if (!(dns ?? const []).contains('1.1.1.1')) '1.1.1.1',
                    if (!(dns ?? const []).contains('8.8.8.8')) '8.8.8.8',
                  ]
                },
                'routing': {'domainStrategy': 'IPIfNonMatch', 'rules': []},
              };
            }
          
            List<int>? _wgReserved(String? v) {
              if (v == null || v.trim().isEmpty) return null;
              final p = v.split(RegExp(r'[,\s]+')).where((e) => e.isNotEmpty).toList();
              if (p.length != 3) return null;
              final r = p.map(int.tryParse).toList();
              if (r.any((e) => e == null || e < 0 || e > 255)) return null;
              return r.cast<int>();
            }
          
            String _wgEndpoint(String host, int port) =>
                host.contains(':') ? '[$host]:$port' : '$host:$port';
          
            /// wireguard://PRIVATEKEY@host:port?address=..&publickey=..&mtu=..&reserved=1,2,3#name
            Map<String, dynamic>? _wgFromLink(String link) {
              try {
                final u = Uri.parse(link.trim());
                // در base64 علامت + ممکنه در آدرس به فاصله تبدیل شده باشه
                String fix(String? v) => (v ?? '').trim().replaceAll(' ', '+');
                final q = <String, String>{
                  for (final e in u.queryParameters.entries) e.key.toLowerCase(): e.value,
                };
                final secret = fix(Uri.decodeComponent(u.userInfo));
                final pub = fix(q['publickey']);
                final host = u.host;
                if (secret.isEmpty || pub.isEmpty || host.isEmpty) return null;
                final addr = (q['address'] ?? q['ip'] ?? '')
                    .split(',')
                    .map((e) => e.trim())
                    .where((e) => e.isNotEmpty)
                    .toList();
                if (addr.isEmpty) return null;
                final psk = fix(q['presharedkey'] ?? q['psk']);
                final ka = int.tryParse(q['keepalive'] ?? q['persistentkeepalive'] ?? '');
                String remark = 'WireGuard';
                if (u.fragment.isNotEmpty) {
                  try {
                    remark = Uri.decodeComponent(u.fragment);
                  } catch (_) {}
                }
                return _wgConfig(
                  secretKey: secret,
                  address: addr,
                  peers: [
                    {
                      'publicKey': pub,
                      if (psk.isNotEmpty) 'preSharedKey': psk,
                      'endpoint': _wgEndpoint(host, u.hasPort ? u.port : 51820),
                      if ((q['allowedips'] ?? '').trim().isNotEmpty)
                        'allowedIPs': q['allowedips']!.split(',').map((e) => e.trim()).where((e) => e.isNotEmpty).toList(),
                      if (ka != null && ka > 0) 'keepAlive': ka,
                    }
                  ],
                  mtu: int.tryParse(q['mtu'] ?? ''),
                  reserved: _wgReserved(q['reserved']),
                  remark: remark,
                );
              } catch (_) {
                return null;
              }
            }
          
            bool _looksLikeWgConf(String t) =>
                RegExp(r'^\s*\[Interface\]', caseSensitive: false, multiLine: true).hasMatch(t) &&
                RegExp(r'^\s*\[Peer\]', caseSensitive: false, multiLine: true).hasMatch(t);
          
            /// فایل/متن استاندارد WireGuard (.conf) با بخش‌های [Interface] و [Peer]
            Map<String, dynamic>? _wgFromConf(String text) {
              try {
                String sec = '';
                String remark = '';
                final iface = <String, String>{};
                final peers = <Map<String, String>>[];
                for (final raw in text.split(RegExp(r'\r?\n'))) {
                  final line = raw.trim();
                  if (line.isEmpty) continue;
                  if (line.startsWith('#') || line.startsWith(';')) {
                    final cm = line.substring(1).trim();
                    if (remark.isEmpty && cm.isNotEmpty && cm.length <= 40) remark = cm;
                    continue;
                  }
                  if (line.startsWith('[')) {
                    sec = line.toLowerCase();
                    if (sec == '[peer]') peers.add(<String, String>{});
                    continue;
                  }
                  final i = line.indexOf('=');
                  if (i <= 0) continue;
                  final k = line.substring(0, i).trim().toLowerCase();
                  final v = line.substring(i + 1).trim();
                  if (sec == '[interface]') {
                    iface[k] = v;
                  } else if (sec == '[peer]' && peers.isNotEmpty) {
                    peers.last[k] = v;
                  }
                }
                final secret = iface['privatekey'] ?? '';
                final addr = (iface['address'] ?? '')
                    .split(',')
                    .map((e) => e.trim())
                    .where((e) => e.isNotEmpty)
                    .toList();
                if (secret.isEmpty || addr.isEmpty || peers.isEmpty) return null;
                final outPeers = <Map<String, dynamic>>[];
                for (final p in peers) {
                  final pub = p['publickey'] ?? '';
                  final ep = p['endpoint'] ?? '';
                  if (pub.isEmpty || ep.isEmpty) continue;
                  final ka = int.tryParse(p['persistentkeepalive'] ?? '');
                  final psk = p['presharedkey'] ?? '';
                  final allowed = (p['allowedips'] ?? '')
                      .split(',')
                      .map((e) => e.trim())
                      .where((e) => e.isNotEmpty)
                      .toList();
                  outPeers.add({
                    'publicKey': pub,
                    if (psk.isNotEmpty) 'preSharedKey': psk,
                    'endpoint': ep,
                    if (allowed.isNotEmpty) 'allowedIPs': allowed,
                    if (ka != null && ka > 0) 'keepAlive': ka,
                  });
                }
                if (outPeers.isEmpty) return null;
                if (remark.isEmpty) {
                  final ep = outPeers.first['endpoint'].toString();
                  remark = 'WG ${ep.split(':').first.replaceAll('[', '')}';
                }
                return _wgConfig(
                  secretKey: secret,
                  address: addr,
                  peers: outPeers,
                  mtu: int.tryParse(iface['mtu'] ?? ''),
                  reserved: _wgReserved(iface['reserved'] ?? peers.first['reserved']),
                  dns: (iface['dns'] ?? '')
                      .split(',')
                      .map((e) => e.trim())
                      .where((e) => InternetAddress.tryParse(e) != null)
                      .toList(),
                  remark: remark,
                );
              } catch (_) {
                return null;
              }
            }
          
            /// کانفیگ نهایی؛ اگه تنظیمات DNS و مسیر دست‌نخورده باشن، کانفیگ اصلی برمی‌گرده.
            String _buildConfig(Cfg c, {int? strat}) {
              final base = _fullConfig(c);
              final st = strat ?? _strat[c.link] ?? (S.fragment ? 2 : 0);
              final needsDns = !c.isJson && S.dnsPreset != 'default';
              final needsRoute = S.domainStrategy != 'default' ||
                  S.bypassIr ||
                  S.directDomains.trim().isNotEmpty ||
                  S.blockDomains.trim().isNotEmpty;
              if (!needsDns && !needsRoute && !S.perf && st == 0) return base;
              try {
                final decoded = jsonDecode(base);
                if (decoded is! Map) return base;
                final m = Map<String, dynamic>.from(decoded);
                try {
                  _tune(m, st);
                } catch (_) {}
                if (needsDns) {
                  final servers = S.dnsServers();
                  if (servers.isNotEmpty) {
                    m['dns'] = {'servers': servers, if (S.perf) 'queryStrategy': 'UseIPv4'};
                  }
                }
                if (needsRoute) {
                  final outs = (m['outbounds'] is List)
                      ? List<dynamic>.from(m['outbounds'] as List)
                      : <dynamic>[];
                  bool hasTag(String t) => outs.any((o) => o is Map && o['tag'] == t);
                  final routing = (m['routing'] is Map)
                      ? Map<String, dynamic>.from(m['routing'] as Map)
                      : <String, dynamic>{};
                  final rules = (routing['rules'] is List)
                      ? List<dynamic>.from(routing['rules'] as List)
                      : <dynamic>[];
                  final front = <dynamic>[];
                  final direct = <String>[
                    ...S.listOf(S.directDomains).map((d) => 'domain:$d'),
                    if (S.bypassIr) 'domain:ir',
                  ];
                  final block = S.listOf(S.blockDomains).map((d) => 'domain:$d').toList();
                  if (direct.isNotEmpty) {
                    if (!hasTag('direct')) {
                      outs.add({'protocol': 'freedom', 'tag': 'direct', 'settings': {}});
                    }
                    front.add(
                        {'type': 'field', 'domain': direct, 'outboundTag': 'direct'});
                  }
                  if (block.isNotEmpty) {
                    if (!hasTag('block')) {
                      outs.add({'protocol': 'blackhole', 'tag': 'block', 'settings': {}});
                    }
                    front
                        .add({'type': 'field', 'domain': block, 'outboundTag': 'block'});
                  }
                  routing['rules'] = [...front, ...rules];
                  if (S.domainStrategy != 'default') {
                    routing['domainStrategy'] = S.domainStrategy;
                  }
                  m['routing'] = routing;
                  m['outbounds'] = outs;
                }
                return jsonEncode(m);
              } catch (_) {
                return base;
              }
            }
          
              /// تنظیمات بهترین عملکرد برای نت ضعیف و کانفیگ‌های ضعیف
            void _tune(Map<String, dynamic> m, int strat) {
              const proxies = ['vmess', 'vless', 'trojan', 'shadowsocks'];
              final outsRaw = m['outbounds'];
              if (outsRaw is! List) return;
              final outs = List<dynamic>.from(outsRaw);
          
              if (S.perf) {
                // زمان‌بندی‌ها: اتصال کند زود رها نشه، اتصال مرده زود پاک بشه
                final policy = (m['policy'] is Map)
                    ? Map<String, dynamic>.from(m['policy'] as Map)
                    : <String, dynamic>{};
                final levels = (policy['levels'] is Map)
                    ? Map<String, dynamic>.from(policy['levels'] as Map)
                    : <String, dynamic>{};
                final l0 = (levels['0'] is Map)
                    ? Map<String, dynamic>.from(levels['0'] as Map)
                    : <String, dynamic>{};
                l0['handshake'] = 10;
                l0['connIdle'] = 300;
                l0['uplinkOnly'] = 2;
                l0['downlinkOnly'] = 5;
                levels['0'] = l0;
                policy['levels'] = levels;
                m['policy'] = policy;
                final dnsRaw = m['dns'];
                if (dnsRaw is Map && dnsRaw['queryStrategy'] == null) {
                  m['dns'] = {...Map<String, dynamic>.from(dnsRaw), 'queryStrategy': 'UseIPv4'};
                }
              }
          
              for (int i = 0; i < outs.length; i++) {
                final o = outs[i];
                if (o is! Map) continue;
                final proto = (o['protocol'] ?? '').toString();
                if (!proxies.contains(proto)) continue;
                final om = Map<String, dynamic>.from(o);
                final ss = (om['streamSettings'] is Map)
                    ? Map<String, dynamic>.from(om['streamSettings'] as Map)
                    : <String, dynamic>{};
                final net = (ss['network'] ?? 'tcp').toString();
                final sec = (ss['security'] ?? 'none').toString();
                final sock = (ss['sockopt'] is Map)
                    ? Map<String, dynamic>.from(ss['sockopt'] as Map)
                    : <String, dynamic>{};
          
                final fragOk = (strat == 2 || strat == 3) &&
                    sec == 'tls' &&
                    (net == 'tcp' || net == 'ws' || net == 'grpc' || net == 'httpupgrade') &&
                    sock['dialerProxy'] == null;
          
                if (strat >= 1) sock['domainStrategy'] ??= 'UseIPv4';
                if (S.perf) {
                  sock['tcpKeepAliveIdle'] ??= 30;
                  sock['tcpKeepAliveInterval'] ??= 15;
                  sock['tcpNoDelay'] ??= true;
                }
          
                if (fragOk) {
                  sock['dialerProxy'] = 'fragment';
                  if (!outs.any((e) => e is Map && e['tag'] == 'fragment')) {
                    outs.add({
                      'tag': 'fragment',
                      'protocol': 'freedom',
                      'settings': {
                        'fragment': {
                          'packets': 'tlshello',
                          'length': strat == 3 ? '10-30' : '100-200',
                          'interval': '10-20',
                        },
                      },
                      'streamSettings': {
                        'sockopt': {'tcpNoDelay': true},
                      },
                    });
                  }
                }
          
                if (sock.isNotEmpty) ss['sockopt'] = sock;
                if (ss.isNotEmpty) om['streamSettings'] = ss;
                outs[i] = om;
              }
              m['outbounds'] = outs;
            }
          
