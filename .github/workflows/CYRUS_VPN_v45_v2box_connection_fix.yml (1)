            /// فایل Cyrus VPN: هر فایلی که داخلش لینک کانفیگ، JSON یا لینک ساب باشه
            Future<void> _importFile() async {
              try {
                final r = await FilePicker.platform.pickFiles(type: FileType.any, withData: true);
                if (r == null || r.files.isEmpty) return;
                final f = r.files.first;
                Uint8List? bytes = f.bytes;
                if (bytes == null && f.path != null) bytes = await File(f.path!).readAsBytes();
                if (bytes == null) {
                  return _toast(tr('فایل خوانده نشد', 'Could not read the file'));
                }
                if (bytes.length > 5 * 1024 * 1024) {
                  return _toast(tr('فایل خیلی بزرگه', 'The file is too large'));
                }
                var text = utf8.decode(bytes, allowMalformed: true).trim();
                if (text.startsWith('\uFEFF')) text = text.substring(1).trim();
                // بعضی فایل‌ها کل محتوا رو base64 ذخیره می‌کنن
                if (text.isNotEmpty && !text.contains('://') && !text.startsWith('{')) {
                  try {
                    text = utf8.decode(base64.decode(base64.normalize(text))).trim();
                  } catch (_) {}
                }
                final parts = text.split(RegExp(r'[\r\n\s]+')).where((e) => e.isNotEmpty).toList();
                if (!text.startsWith('{') &&
                    !parts.any(_isLink) &&
                    parts.any((e) => e.startsWith('http://') || e.startsWith('https://'))) {
                  for (final p in parts.where((e) => e.startsWith('http://') || e.startsWith('https://'))) {
                    await _handleInput(p);
                  }
                  return;
                }
                await _handleInput(text);
              } catch (e) {
                _toast(tr('خواندن فایل ناموفق بود: $e', 'Could not read the file: $e'));
              }
            }
          
