            // ---------- پینگ واقعی ----------
          
            static const _pingUrlA = 'http://cp.cloudflare.com/generate_204';
            static const _pingUrlB = 'https://www.gstatic.com/generate_204';
            bool _noConnDelay = false; // نسخه افزونه پینگ کانفیگ وصل رو نداره
          
            /// یک بار پینگ واقعی با هسته؛ -1 یعنی جواب نیومد
            Future<int> _delayWith(String cfg, String url, int secs) async {
              try {
                final dynamic v = _v2ray;
                dynamic x;
                try {
                  x = await v.getServerDelay(config: cfg, url: url).timeout(Duration(seconds: secs));
                } on NoSuchMethodError {
                  // نسخه افزونه آدرس تست رو قبول نمی‌کنه
                  x = await v.getServerDelay(config: cfg).timeout(Duration(seconds: secs));
                }
                return (x is num) ? x.toInt() : -1;
              } catch (_) {
                return -1;
              }
            }
          
            /// آدرس تست HTTP ساده (بدون TLS تا مقصد) پینگ نزدیک‌تر به واقعیت می‌ده؛
            /// فقط اگه همون لحظه خطا داد آدرس دوم امتحان می‌شه
            Future<int> _delayRaw(String cfg, int secs) async {
              final sw = Stopwatch()..start();
              final r = await _delayWith(cfg, _pingUrlA, secs);
              if (r > 0) return r;
              if (sw.elapsedMilliseconds < 3000) {
                return _delayWith(cfg, _pingUrlB, secs);
              }
              return -1;
            }
          
            /// روش‌های اتصال: ۰ ساده، ۱ با DNS داخل هسته، ۲ و ۳ با فرگمنت (ضد فیلتر).
            /// برای هر کانفیگ خودش پیدا می‌کنه کدوم روش روی اینترنت فعلی جواب می‌ده
            /// و همون رو برای پینگ و اتصال به کار می‌بره.
            Future<int> _delayOf(Cfg c, {int tries = 1}) async {
              if (_unsupported(c)) return -1;
              final known = _strat[c.link];
              final bool quick = known != null && tries < 2;
              final List<int> order = quick
                  ? [known!]
                  : [
                      if (known != null) known,
                      for (final x in (S.fragment ? const [2, 3, 1, 0] : const [0, 1, 2, 3]))
                        if (x != known) x,
                    ];
              int d = -1;
              int used = -1;
              String usedCfg = '';
              final tried = <String>{};
              int attempt = 0;
              for (final x in order) {
                String cfg = '';
                try {
                  cfg = _buildConfig(c, strat: x);
                } catch (_) {}
                if (cfg.isEmpty || !tried.add(cfg)) continue;
                // اولین تلاش وقت بیشتری می‌گیره تا کانفیگ کند، پایان زمان الکی نخوره
                d = await _delayRaw(cfg, quick ? 6 : (attempt == 0 ? 5 : 3));
                attempt++;
                if (d > 0) {
                  used = x;
                  usedCfg = cfg;
                  break;
                }
              }
              if (d <= 0) {
                if (quick) {
                  // سه بار پشت‌سرهم جواب نداد؛ شاید اینترنت عوض شده، دوباره همه روش‌ها امتحان بشه
                  final n = (_stratFail[c.link] ?? 0) + 1;
                  _stratFail[c.link] = n;
                  if (n >= 3) {
                    _strat.remove(c.link);
                    _stratFail.remove(c.link);
                  }
                }
                return -1;
              }
              _stratFail.remove(c.link);
              if (_strat[c.link] != used) {
                _strat[c.link] = used;
                _save();
              }
              // Use the median of repeated samples; minimum latency is overly optimistic
              // and often makes the displayed ping look better than the real connection.
              final samples = <int>[d];
              for (int i = 1; i < math.max(tries, 3); i++) {
                final d2 = await _delayRaw(usedCfg, 8);
                if (d2 > 0) samples.add(d2);
              }
              if (samples.isEmpty) return -1;
              samples.sort();
              return samples[samples.length ~/ 2];
            }
          
            // ---------- پینگ TCP (مثل V2Box / v2rayNG) ----------
          
            final Map<String, _Ep?> _eps = {};
            final Map<String, List<InternetAddress>> _dnsCache = {};
          
            /// آدرس و پورت سرور؛ برای WireGuard (UDP) و کانفیگ ناشناخته null برمی‌گرده
            _Ep? _endpointOf(Cfg c) => _eps.putIfAbsent(c.link, () => _calcEndpoint(c));
          
            _Ep? _calcEndpoint(Cfg c) {
              try {
                final m = jsonDecode(_fullConfig(c));
                if (m is! Map) return null;
                final obs = m['outbounds'];
                if (obs is! List) return null;
                for (final o in obs) {
                  if (o is! Map) continue;
                  final p = (o['protocol'] ?? '').toString();
                  final st = o['settings'];
                  if (st is! Map) continue;
                  dynamic e;
                  if (p == 'vmess' || p == 'vless') {
                    final v = st['vnext'];
                    if (v is List && v.isNotEmpty) e = v[0];
                  } else if (p == 'trojan' || p == 'shadowsocks' || p == 'socks' || p == 'http') {
                    final v = st['servers'];
                    if (v is List && v.isNotEmpty) e = v[0];
                  } else if (p == 'wireguard') {
                    return null; // UDP؛ با TCP پینگ نمی‌شه
                  }
                  if (e is Map) {
                    final host = (e['address'] ?? '').toString().trim();
                    final port = int.tryParse((e['port'] ?? '').toString());
                    if (host.isNotEmpty && port != null && port > 0 && port < 65536) {
                      return _Ep(host, port);
                    }
                  }
                }
              } catch (_) {}
              return null;
            }
          
            bool _badIp(InternetAddress a) {
              if (a.isLoopback || a.isLinkLocal) return true;
              if (a.type == InternetAddressType.IPv4) {
                final b = a.rawAddress;
                return b[0] == 0 ||
                    b[0] == 10 ||
                    b[0] == 127 ||
                    (b[0] == 192 && b[1] == 168) ||
                    (b[0] == 172 && b[1] >= 16 && b[1] <= 31);
              }
              return false;
            }
          
            /// DNS روی HTTPS؛ وقتی DNS گوشی جواب نده یا آدرس جعلی (داخلی) بده
            Future<List<InternetAddress>> _dohLookup(String host) async {
              final out = <InternetAddress>[];
              for (final t in const ['A', 'AAAA']) {
                try {
                  final r = await http.get(
                    Uri.parse('https://1.1.1.1/dns-query?name=${Uri.encodeQueryComponent(host)}&type=$t'),
                    headers: const {'accept': 'application/dns-json'},
                  ).timeout(const Duration(seconds: 4));
                  if (r.statusCode != 200) continue;
                  final j = jsonDecode(r.body);
                  final ans = j is Map ? j['Answer'] : null;
                  if (ans is List) {
                    for (final a in ans) {
                      if (a is Map) {
                        final d = InternetAddress.tryParse((a['data'] ?? '').toString());
                        if (d != null) out.add(d);
                      }
                    }
                  }
                } catch (_) {}
                if (out.isNotEmpty) break;
              }
              return out;
            }
          
            Future<List<InternetAddress>> _resolve(String host) async {
              final lit = InternetAddress.tryParse(host);
              if (lit != null) return [lit];
              List<InternetAddress> list = [];
              try {
                list = await InternetAddress.lookup(host).timeout(const Duration(seconds: 3));
              } catch (_) {}
              list = list.where((a) => !_badIp(a)).toList();
              if (list.isEmpty) list = await _dohLookup(host);
              // IPv4 اول؛ IPv6 روی خیلی از شبکه‌ها وصل نمی‌شه و پینگ الکی «پایان زمان» می‌خوره
              list.sort((a, b) =>
                  (a.type == InternetAddressType.IPv4 ? 0 : 1) - (b.type == InternetAddressType.IPv4 ? 0 : 1));
              return list;
            }
          
            Future<int> _connectOnce(List<InternetAddress> addrs, int port, {bool refusedOk = false}) async {
              int n = 0;
              for (final a in addrs.take(2)) {
                final sw = Stopwatch()..start();
                try {
                  final sock = await Socket.connect(a, port,
                      timeout: Duration(milliseconds: n == 0 ? 4000 : 2500));
                  sw.stop();
                  sock.destroy();
                  return math.max(1, sw.elapsedMilliseconds);
                } on SocketException catch (e) {
                  // پورت UDP (WireGuard): سرور به اتصال TCP «رد شد» (RST) می‌ده و همین زمان رفت‌وبرگشت رو نشون می‌ده
                  if (refusedOk && e.osError?.errorCode == 111) {
                    sw.stop();
                    return math.max(1, sw.elapsedMilliseconds);
                  }
                } catch (_) {}
                n++;
              }
              return -1;
            }
          
            /// کمترین زمان اتصال TCP به سرور؛ -1 یعنی جواب نداد
            Future<int> _tcpPing(_Ep ep, {int tries = 2, bool refusedOk = false}) async {
              var addrs = _dnsCache[ep.host];
              if (addrs == null || addrs.isEmpty) {
                addrs = await _resolve(ep.host);
                if (addrs.isEmpty) return -1;
                _dnsCache[ep.host] = addrs; // زمان DNS داخل پینگ حساب نمی‌شه
              }
              int best = -1;
              for (int i = 0; i < tries; i++) {
                final sw = Stopwatch()..start();
                final t = await _connectOnce(addrs, ep.port, refusedOk: refusedOk);
                if (t > 0 && (best < 0 || t < best)) best = t;
                if (t < 0 && best < 0) {
                  _dnsCache.remove(ep.host); // شاید IP عوض شده، دفعه بعد دوباره resolve بشه
                  // پایان زمان واقعی دوباره امتحان نمی‌شه؛ فقط خطای سریع (قطع لحظه‌ای)
                  if (sw.elapsedMilliseconds >= 2500 || i >= 1) break;
                }
              }
              return best;
            }
          
            final Map<String, bool> _wgCache = {};
            final Map<String, _Ep?> _wgEps = {};
          
            /// آدرس Endpoint سرور WireGuard (UDP)
            _Ep? _wgEndpointOf(Cfg c) => _wgEps.putIfAbsent(c.link, () {
                  try {
                    // لینک wireguard:// ابتدا به JSON استاندارد هسته تبدیل می‌شود؛
                    // قبلاً فقط JSON خام خوانده می‌شد و Endpoint لینک‌ها پیدا نمی‌شد.
                    final raw = _fullConfig(c);
                    final m = jsonDecode(raw);
                    if (m is! Map || m['outbounds'] is! List) return null;
                    for (final o in m['outbounds'] as List) {
                      if (o is! Map || (o['protocol'] ?? '').toString().toLowerCase() != 'wireguard') continue;
                      final st = o['settings'];
                      if (st is! Map || st['peers'] is! List) continue;
                      for (final peer in st['peers'] as List) {
                        if (peer is! Map) continue;
                        final ep = (peer['endpoint'] ?? '').toString().trim();
                        // پشتیبانی از IPv4/دامنه و IPv6 داخل کروشه
                        final match = RegExp(r'^\[([^\]]+)\]:(\d+)$').firstMatch(ep);
                        String host;
                        int? port;
                        if (match != null) {
                          host = match.group(1)!;
                          port = int.tryParse(match.group(2)!);
                        } else {
                          final i = ep.lastIndexOf(':');
                          if (i <= 0) continue;
                          host = ep.substring(0, i);
                          port = int.tryParse(ep.substring(i + 1));
                        }
                        if (host.isNotEmpty && port != null && port > 0 && port < 65536) {
                          return _Ep(host, port);
                        }
                      }
                    }
                  } catch (e) {
                    debugPrint('WireGuard endpoint parse failed: ${e.runtimeType}');
                  }
                  return null;
                });
          
            /// برای ردپای خطا: نوع کانفیگ و آدرس سرور
            String _kindOf(Cfg c) {
              final kind = c.isJson ? 'json' : c.link.split('://').first.toLowerCase();
              final ep = _isWg(c) ? null : _endpointOf(c);
              return ep == null ? kind : '$kind ${ep.host}:${ep.port}';
            }
            final Map<String, List<int>> _pingRecent = {};
          
            // ---------- وصل مجدد خودکار (قطع شدن شبانه / بسته شدن سرویس توسط سیستم) ----------
            bool _dropSeen = false;
            int _rcAttempt = 0;
            DateTime _rcNext = DateTime.fromMillisecondsSinceEpoch(0);
            DateTime _switchingUntil = DateTime.fromMillisecondsSinceEpoch(0);
          
            Future<void> _reconnectTick() async {
              if (!_dropSeen || !S.autoReconnect || !S.wantOn) return;
              if (_connected || _connecting || _retrying || _probing) return;
              final now = DateTime.now();
              if (now.isBefore(_switchingUntil) || now.isBefore(_rcNext)) return;
              final c = _byLink(_selected);
              if (c == null) return;
              if (_rcAttempt >= 6) {
                // بعد از چند تلاش بی‌نتیجه (حدود ۶ دقیقه) رها می‌کنیم تا باتری و داده هدر نره
                _dropSeen = false;
                return;
              }
              // فاصله بین تلاش‌ها: ۵، ۱۵، ۳۰، ۶۰ و بعد هر ۱۲۰ ثانیه
              const gaps = [5, 15, 30, 60, 120];
              _rcNext = now.add(Duration(seconds: gaps[math.min(_rcAttempt, gaps.length - 1)]));
              _rcAttempt++;
              _coreEvent('auto-reconnect #$_rcAttempt');
              if (_rcAttempt == 1) {
                _toast(tr('اتصال قطع شد؛ دوباره وصل می‌شم (اگه نمی‌خوای، «وصل شدن دوباره خودکار» رو در تنظیمات خاموش کن)',
                    'Connection dropped; reconnecting (turn off "Auto reconnect" in settings if you do not want this)'));
              }
              await _connect();
            }
          
            /// بهینه‌سازی باتری رو کنار می‌ذاره تا سیستم شب سرویس VPN رو نبنده
            Future<void> _askBatteryExemption() async {
              try {
                if (await Permission.ignoreBatteryOptimizations.isGranted) return;
                await Permission.ignoreBatteryOptimizations.request();
              } catch (_) {}
            }
          
            /// لاگ هسته رو توی یه فایل می‌نویسه تا از «گزارش هسته» توی تنظیمات دیده بشه
            String _withLog(Cfg c, String cfg) {
              try {
                final m = jsonDecode(cfg);
                if (m is! Map) return cfg;
                // لاگ دقیق (debug) سرعت رو خیلی کم می‌کنه؛ فقط وقتی کاربر برای عیب‌یابی روشن کرده
                if (S.debugLog) m['log'] = {'loglevel': 'debug'};
                final out = jsonEncode(m);
                try {
                  lastSentCfg = jsonEncode(_maskSecrets(jsonDecode(out)));
                } catch (_) {}
                return out;
              } catch (_) {
                return cfg;
              }
            }
          
            /// WireGuard: دامنه Endpoint قبل از بالا آمدن تونل به IP تبدیل می‌شه
            /// (وگرنه DNS هسته اول از خود تونل ناقص رد می‌شه و وصل نمی‌شه)
            Future<String> _prepCfg(Cfg c, String cfg) async {
              if (!_isWg(c)) return cfg;
              // چیدمان‌های مختلف؛ اگه handshake نشد، _verifyTunnel خودکار بعدی رو امتحان می‌کنه:
              // 0 خروجی نمایشی + MTU کانفیگ، 2 خروجی نمایشی + MTU 1280، 1 بدون خروجی نمایشی، 3 بدون نمایشی + MTU 1280
              final variant = _strat[c.link] ?? 0;
              final useStub = variant == 0 || variant == 2;
              final capMtu = variant >= 2;
              try {
                final m = jsonDecode(cfg);
                if (m is! Map || m['outbounds'] is! List) return cfg;
                // درخواست AAAA روی سروری که IPv6 نداره باعث کندی بارگذاری صفحه‌ها می‌شه
                final dnsCfg = m['dns'];
                if (dnsCfg is Map) dnsCfg['queryStrategy'] = 'UseIPv4';
                for (final o in m['outbounds'] as List) {
                  if (o is! Map || o['protocol'] != 'wireguard') continue;
                  final st = o['settings'];
                  if (st is! Map || st['peers'] is! List) continue;
                  final mt = st['mtu'];
                  if (mt is int) {
                    if (capMtu && mt > 1280) {
                      st['mtu'] = 1280;
                    } else if (mt > 1420) {
                      st['mtu'] = 1420;
                    }
                  }
                  for (final p in st['peers'] as List) {
                    if (p is! Map) continue;
                    // کانفیگ‌های قبلاً ذخیره‌شده هم keepalive بگیرن
                    final ka = p['keepAlive'];
                    if (ka == null || ka == 0) {
                      p['keepAlive'] = 15;
                    } else if (ka is int && ka > 25) {
                      p['keepAlive'] = 25;
                    }
                    final ep = (p['endpoint'] ?? '').toString();
                    final i = ep.lastIndexOf(':');
                    if (i <= 0) continue;
                    var host = ep.substring(0, i);
                    final port = ep.substring(i + 1);
                    if (host.startsWith('[') && host.endsWith(']')) {
                      host = host.substring(1, host.length - 1);
                    }
                    if (InternetAddress.tryParse(host) == null) {
                      final ips = await _resolve(host);
                      if (ips.isNotEmpty) {
                        final ip = ips.first;
                        host = ip.address;
                        p['endpoint'] = ip.type == InternetAddressType.IPv6
                            ? '[$host]:$port'
                            : '$host:$port';
                      }
                    }
                  }
                }
                // افزونه آدرس سرور رو فقط از «خروجی اول» می‌خونه (vnext یا servers) و اگه نباشه
                // اتصال رو بی‌صدا رد می‌کنه؛ WireGuard هیچ‌کدوم رو نداره. پس یه خروجی نمایشی (که هیچ
                // ترافیکی بهش نمی‌رسه) اول می‌ذاریم و همه ترافیک رو با قانون مسیر به WireGuard می‌فرستیم.
                final outs = m['outbounds'] as List;
                if (outs.isNotEmpty && outs.first is Map && (outs.first as Map)['protocol'] == 'wireguard') {
                  final wg = outs.first as Map;
                  wg['tag'] ??= 'proxy';
                  if (useStub) outs.insert(0, {
                    'tag': 'plugin-stub',
                    'protocol': 'socks',
                    'settings': {
                      'servers': [
                        {'address': '127.0.0.1', 'port': 1}
                      ]
                    },
                  });
                  if (useStub) {
                    final routing = m['routing'] is Map ? m['routing'] as Map : <String, dynamic>{};
                    final rules = routing['rules'] is List ? routing['rules'] as List : <dynamic>[];
                    rules.add({'type': 'field', 'network': 'tcp,udp', 'outboundTag': wg['tag']});
                    routing['rules'] = rules;
                    m['routing'] = routing;
                  }
                }
                return jsonEncode(m);
              } catch (_) {
                return cfg;
              }
            }
          
            /// کانفیگ WireGuard (لینک یا JSON)
            bool _isWg(Cfg c) => _wgCache.putIfAbsent(c.link, () {
                  if (c.link.toLowerCase().startsWith('wireguard://')) return true;
                  return c.isJson && RegExp(r'"protocol"\s*:\s*"wireguard"').hasMatch(c.link);
                });
          
            // ---------- محافظ کرش: تست هسته‌ای که برنامه رو می‌بنده دیگه خودکار تکرار نمی‌شه ----------
          
            final Set<String> _coreActive = {};
            final Set<String> _coreBad = {};
          
            Future<void> _coreMark(String link, bool on) async {
              if (on) {
                _coreActive.add(link);
              } else {
                _coreActive.remove(link);
              }
              try {
                final p = await SharedPreferences.getInstance();
                if (_coreActive.isEmpty) {
                  await p.remove('coreActive');
                } else {
                  await p.setStringList('coreActive', _coreActive.toList());
                }
              } catch (_) {}
            }
          
            /// اگه دفعه قبل وسط تست هسته برنامه بسته شده، اون کانفیگ علامت می‌خوره؛ true یعنی کرش بوده
            Future<bool> _coreCrashCheck() async {
              bool crashed = false;
              try {
                final p = await SharedPreferences.getInstance();
                final act = p.getStringList('coreActive') ?? const <String>[];
                _coreBad.addAll(p.getStringList('coreBad') ?? const <String>[]);
                if (act.isNotEmpty) {
                  crashed = true;
                  _coreBad.addAll(act);
                  await p.setStringList('coreBad', _coreBad.toList());
                  await p.remove('coreActive');
                }
              } catch (_) {}
              return crashed;
            }
          
            /// Ping uses the V2Ray core delay API through the selected proxy; WireGuard is measured only through an active tunnel.
            Future<int> _pingValue(Cfg c, {int tries = 1}) async {
              if (_unsupported(c)) return -1;
              // WireGuard روی UDP کار می‌کند؛ TCP connect به Endpoint آن پینگ معتبر نیست.
              // پیش از اتصال عدد ساختگی نشان نده؛ پس از اتصال _liveTick تأخیر واقعی تونل را ثبت می‌کند.
              if (_isWg(c)) {
                final active = _connected && (_activeLink == c.link || _selected == c.link);
                if (!active) return -2;
                final live = await _connectedDelay();
                if (live > 0) return live;
                final fallback = await _httpLive();
                return fallback > 0 ? fallback : -2;
              }
              // برای عدد قابل اتکا، زمان اتصال TCP به پورت سرور را به‌عنوان پینگ نشان نمی‌دهیم.
              // تست هسته، درخواست را از مسیر پروکسی همان کانفیگ عبور می‌دهد.
              if (_coreBad.contains(c.link)) return -1;
              await _coreMark(c.link, true);
              try {
                return await _delayOf(c, tries: tries);
              } finally {
                await _coreMark(c.link, false);
              }
            }
          
            int _pingGen = 0;
          
            void _cancelPings() {
              _pingGen++;
              _pinging = false;
            }
          
            /// manual: درخواست خود کاربر؛ هر پینگ پس‌زمینه‌ای که در جریانه کنار می‌ره
            /// tries: تعداد نمونه‌ها؛ مقدار میانه نمایش داده می‌شود تا پینگ خوش‌بینانه نباشد
            Future<void> _pingConfigs(List<Cfg> list,
                {bool manual = false, int tries = 1}) async {
              if (list.isEmpty) return;
              if (_connected || _connecting || _retrying) {
                if (manual) {
                  _toast(tr('هنگام اتصال، پینگ سرورها متوقف است', 'Server ping is paused while the VPN is connecting or connected'));
                }
                return;
              }
              if (_pinging && !manual) return;
              final gen = ++_pingGen;
              _pinging = true;
              final items = List<Cfg>.from(list);
              if (items.isEmpty) {
                _pinging = false;
                return;
              }
              _pingDone = 0;
              _pingTotal = items.length;
              if (mounted) setState(() {});
              if (manual && items.length > 1) {
                _toast(tr('در حال پینگ ${items.length} کانفیگ...',
                    'Pinging ${items.length} configs...'));
              }
              // صف با چند کارگر هم‌زمان؛ هر نتیجه همان لحظه روی کارت نشون داده می‌شه
              int next = 0;
              Future<void> worker() async {
                while (gen == _pingGen) {
                  final i = next++;
                  if (i >= items.length) return;
                  final c = items[i];
                  final old = _pings[c.link] ?? -1;
                  // کانفیگی که تست واقعی آن را مردود کرده، تا پایان دوره‌ی قرنطینه
                  // دوباره بی‌دلیل پینگ نمی‌شود؛ فقط درخواست دستی می‌تواند تست را تکرار کند.
                  if (!manual && _isDead(c.link)) {
                    _pings[c.link] = -1;
                    _pingDone++;
                    _coreEvent('  -> skipped (known dead)');
                    if (mounted) setState(() {});
                    continue;
                  }
                  _coreEvent('ping ${i + 1}/${items.length} ${_kindOf(c)}');
                  int d = -1;
                  try {
                    // مهلت محدود و مشخص؛ در صورت گیرکردن DNS/سوکت، وضعیت پایان زمان ثبت می‌شود.
                    d = await _pingValue(c, tries: tries)
                        .timeout(Duration(seconds: _isWg(c) ? 8 : (S.realPing ? 18 : 16)), onTimeout: () => -1);
                  } catch (e) {
                    _coreEvent('ping error ${e.runtimeType}');
                  }
                  if (d == -2) {
                    // نامعلوم (مثلاً WireGuard پشت فایروال)؛ چیزی ذخیره نمی‌شه
                    _pingDone++;
                    _coreEvent('  -> unknown');
                    if (mounted) setState(() {});
                    continue;
                  }
                  // نتیجه‌ی timeout را دوباره و پشت‌سرهم تکرار نکن؛ زمان پاسخ همین نوبت ملاک است.
                  if (gen != _pingGen) return;
                  // میانه‌ی سه نمونه‌ی اخیر نمایش داده می‌شود تا نوسان کمتر و عدد واقعی‌تر باشد
                  if (d > 0) {
                    final r = _pingRecent.putIfAbsent(c.link, () => <int>[]);
                    if (manual) r.clear();
                    r.add(d);
                    if (r.length > 3) r.removeAt(0);
                    final sorted = List<int>.from(r)..sort();
                    d = sorted[sorted.length ~/ 2];
                  }
                  // پینگ ناموفق را به‌صورت timeout نمایش بده؛ پینگ قبلیِ قدیمی را نگه ندار.
                  if (d <= 0) {
                    _pingMiss[c.link] = (_pingMiss[c.link] ?? 0) + 1;
                    d = -1;
                  } else {
                    _pingMiss.remove(c.link);
                  }
                  if (d > 0 && _isDead(c.link)) d = -1; // تست واقعی قبلاً ردش کرده
                  _pings[c.link] = d;
                  _pingDone++;
                  _coreEvent('  -> $d');
                  if (mounted) setState(() {});
                }
              }
          
              // پینگ TCP سبکه و هم‌زمان بیشتر می‌شه؛ تست واقعی هسته سه‌تا سه‌تا
              await Future.wait(List.generate(3, (_) => worker()));
              if (gen != _pingGen) return;
              _pinging = false;
              if (!manual && items.length == 1) {
                // پینگ ۵ ثانیه‌ای یک کانفیگ؛ لیست جابه‌جا نشه
                if (mounted) setState(() {});
                return;
              }
              await _afterPing();
              if (mounted) setState(() {});
              if (manual && items.length > 1) {
                final ok = items.where((c) => (_pings[c.link] ?? -1) > 0).length;
                _toast(tr('پینگ تمام شد: $ok از ${items.length} کانفیگ جواب داد',
                    'Ping finished: $ok of ${items.length} responded'));
              }
            }
          
            Future<void> _pingAll({bool manual = false, int tries = 1}) =>
                _pingConfigs(_configs, manual: manual, tries: tries);
          
            Future<void> _pingOne(Cfg c) async {
              if (_connected || _connecting || _retrying) return;
              if (_busyPing.contains(c.link)) return;
              setState(() => _busyPing.add(c.link));
              _coreBad.remove(c.link);
              final r = await _pingValue(c, tries: 2);
              if (r == -2) {
                _toast(tr('پینگ WireGuard فقط بعد از وصل شدن و از داخل تونل اندازه‌گیری می‌شود تا درست باشد',
                    'WireGuard ping is measured only after connecting, through the tunnel, so it is accurate'));
              } else {
                _pings[c.link] = r;
                if (r > 0 && !S.realPing && !_connected) {
