            Future<void> _liveTick() async {
              if (!_connected || _probing || _measuring || _retrying) return;
              if (!_foreground) {
                _bgTick++;
                if (_bgTick % 6 != 0) return; // پس‌زمینه / صفحه خاموش: حدود هر ۳۰ ثانیه
              }
              int ms = await _connectedDelay();
              if (ms <= 0) {
                if (S.proxyOnly) {
                  if (ms == -2) return;
                } else {
                  final h = await _httpLive();
                  if (h >= 0) ms = h; // سالمه (۰ یعنی فقط حساب نمی‌شه)
                }
              }
              if (!_connected) return;
              if (ms >= 0) {
                _liveFails = 0;
                if (ms > 0) {
                  _liveSamples.add(ms);
                  if (_liveSamples.length > 4) _liveSamples.removeAt(0);
                  final sorted = List<int>.from(_liveSamples)..sort();
                  _livePing = sorted[sorted.length ~/ 2];
                  _push(_pingHist, _livePing.toDouble());
                  final al = _activeLink;
                  final ac = al == null ? null : _byLink(al);
                  if (ac != null && _isWg(ac)) _pings[ac.link] = _livePing;
                }
              } else {
                _livePing = -1;
                _liveSamples.clear();
                _liveFails++;
                // فقط وقتی چند بار پشت‌سر‌هم جواب نیومد کانفیگ عوض می‌شه
                if (_liveFails >= (_foreground ? 8 : 3)) {
                  _liveFails = 0;
                  // فقط اگه واقعاً اینترنت از تونل رد نمی‌شه کانفیگ عوض یا اتصال دوباره برقرار می‌شه
                  if (!await _tunnelAlive()) {
                    await _failover();
                    if (_connected && S.autoReconnect) await _restartSame();
                  }
                }
              }
              if (mounted) setState(() {});
            }
          
            Future<double?> _downloadMbps({int bytes = 1500000}) async {
              if (!_connected) return null;
              try {
                final client = _live ??= http.Client();
                final sw = Stopwatch()..start();
                final r = await client
                    .get(Uri.parse('https://speed.cloudflare.com/__down?bytes=$bytes'))
                    .timeout(const Duration(seconds: 12));
                sw.stop();
                if (!_connected || r.statusCode != 200 || r.bodyBytes.isEmpty) return null;
                // سرعت با حجم واقعی دریافت‌شده و زمان کامل درخواست محاسبه می‌شود.
                return r.bodyBytes.length * 8 / 1e6 / (math.max(sw.elapsedMilliseconds, 1) / 1000.0);
              } catch (_) {
                return null;
              }
            }
          
            Future<double?> _uploadMbps({int bytes = 700000}) async {
              if (!_connected) return null;
              try {
                final client = _live ??= http.Client();
                final sw = Stopwatch()..start();
                final r = await client
                    .post(Uri.parse('https://speed.cloudflare.com/__up'),
                        body: List<int>.filled(bytes, 65))
                    .timeout(const Duration(seconds: 12));
                sw.stop();
                if (!_connected || r.statusCode < 200 || r.statusCode >= 300) return null;
                return bytes * 8 / 1e6 / (math.max(sw.elapsedMilliseconds, 1) / 1000.0);
              } catch (_) {
                return null;
              }
            }
          
            /// سرعت واقعی دانلود و آپلود کانفیگی که الان وصله
            Future<void> _measureActive() async {
