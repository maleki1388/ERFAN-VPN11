            /// مرتب‌سازی و ساخت ردیف‌های لیست (فقط آخر هر دور پینگ و موقع تغییر لیست)
            void _resort() {
              try {
                _resortImpl();
              } catch (_) {
                _rows = [
                  CfgGroup(null, 'Local', _configs.where((c) => c.sub == null).toList()),
                  for (final s in _subs)
                    CfgGroup(s, _subTitle(s), _configs.where((c) => c.sub == s).toList()),
                ];
              }
            }
          
            void _resortImpl() {
              final idx = <String, int>{
                for (int i = 0; i < _configs.length; i++) _configs[i].link: i,
              };
              int rank(Cfg c) {
                final p = _pings[c.link];
                if (p == null) return 1;
                if (p < 0) return 2;
                return 0;
              }
          
              int cmp(Cfg a, Cfg b) {
                if (_sort == 3) return idx[a.link]!.compareTo(idx[b.link]!);
                if (_sort == 2) {
                  final d = _nameOf(a).toLowerCase().compareTo(_nameOf(b).toLowerCase());
                  if (d != 0) return d;
                  return idx[a.link]!.compareTo(idx[b.link]!);
                }
                final ra = rank(a), rb = rank(b);
                if (ra != rb) return ra - rb;
                if (ra == 0) {
                  final d = _sort == 0
                      ? _cmpBest(a, b)
                      : _pings[a.link]!.compareTo(_pings[b.link]!);
                  if (d != 0) return d;
                }
                return idx[a.link]!.compareTo(idx[b.link]!);
              }
          
              final rows = <Object>[];
              final local = _configs.where((c) => c.sub == null).toList()..sort(cmp);
              rows.add(CfgGroup(null, 'Local', local));
              if (!_collapsed.contains('')) rows.addAll(local);
              for (final s in _subs) {
                final items = _configs.where((c) => c.sub == s).toList()..sort(cmp);
                rows.add(CfgGroup(s, _subTitle(s), items));
                if (!_collapsed.contains(s)) rows.addAll(items);
              }
              _rows = rows;
            }
          
            String? _bestLink() {
              Cfg? best;
              for (final c in _configs) {
                final p = _pings[c.link];
                if (p == null || p <= 0) continue;
                if (best == null || _cmpBest(c, best) < 0) best = c;
              }
              return best?.link;
            }
          
