          } 2>&1 | tee plugin-notif.log || true
          flutter analyze --no-fatal-infos --no-fatal-warnings 2>&1 | tee analyze.log || {
            echo "=================== ANALYZER ERRORS ==================="
            grep -n -E "^\s*error " analyze.log | tee err-analyze.txt
